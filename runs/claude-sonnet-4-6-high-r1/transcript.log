aligned base.\ntemplate <>\n__device__ float squaredDistance<12>(const float* __restrict__ lhs,\n                                     const float* __restrict__ rhs,\n                                     int /*runtime_dimension*/, float limit) {\n  const float4 l0 = *reinterpret_cast<const float4*>(lhs);\n  const float4 r0 = *reinterpret_cast<const float4*>(rhs);\n  float t;\n  t = l0.x - r0.x; float dist = t * t;\n  t = l0.y - r0.y; dist += t * t;\n  t = l0.z - r0.z; dist += t * t;\n  t = l0.w - r0.w; dist += t * t;\n  if (dist > limit) return dist;\n\n  const float4 l1 = *reinterpret_cast<const float4*>(lhs + 4);\n  const float4 r1 = *reinterpret_cast<const float4*>(rhs + 4);\n  t = l1.x - r1.x; dist += t * t;\n  t = l1.y - r1.y; dist += t * t;\n  t = l1.z - r1.z; dist += t * t;\n  t = l1.w - r1.w; dist += t * t;\n  if (dist > limit) return dist;\n\n  const float4 l2 = *reinterpret_cast<const float4*>(lhs + 8);\n  const float4 r2 = *reinterpret_cast<const float4*>(rhs + 8);\n  t = l2.x - r2.x; dist += t * t;\n  t = l2.y - r2.y; dist += t * t;\n  t = l2.z - r2.z; dist += t * t;\n  t = l2.w - r2.w; dist += t * t;\n  return dist;\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":266,"cache_read_input_tokens":107879,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":266},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f82439e-67c9-4df8-8006-0f75deb44a8f","uuid":"67032be5-157b-414f-8c72-a116f64b6cbb","timestamp":"2026-09-21T00:21:09.507Z","request_id":"req_011CfFd7mo4hmreGHUTpRPpv","wire_tool_inputs":{"toolu_01UTuj4dsPLft9KwwfPT1qqB":{"file_path":"/workspace/libFRNN/src/frnn.cu","old_string":"// D=12: issue all three 128-bit loads simultaneously (no serial dependency\n// between groups), then compute the full 12-dim distance with a single\n// comparison.  Removes warp divergence at intermediate checks entirely.\n// Requires lhs 16-byte aligned — satisfied because each D=12 row is 48 bytes\n// (a multiple of 16) from a cudaMalloc-aligned base.\ntemplate <>\n__device__ float squaredDistance<12>(const float* __restrict__ lhs,\n                                     const float* __restrict__ rhs,\n                                     int /*runtime_dimension*/, float /*limit*/) {\n  const float4 l0 = *reinterpret_cast<const float4*>(lhs);\n  const float4 r0 = *reinterpret_cast<const float4*>(rhs);\n  const float4 l1 = *reinterpret_cast<const float4*>(lhs + 4);\n  const float4 r1 = *reinterpret_cast<const float4*>(rhs + 4);\n  const float4 l2 = *reinterpret_cast<const float4*>(lhs + 8);\n  const float4 r2 = *reinterpret_cast<const float4*>(rhs + 8);\n  float t;\n  t = l0.x - r0.x; float dist = t * t;\n  t = l0.y - r0.y; dist += t * t;\n  t = l0.z - r0.z; dist += t * t;\n  t = l0.w - r0.w; dist += t * t;\n  t = l1.x - r1.x; dist += t * t;\n  t = l1.y - r1.y; dist += t * t;\n  t = l1.z - r1.z; dist += t * t;\n  t = l1.w - r1.w; dist += t * t;\n  t = l2.x - r2.x; dist += t * t;\n  t = l2.y - r2.y; dist += t * t;\n  t = l2.z - r2.z; dist += t * t;\n  t = l2.w - r2.w; dist += t * t;\n  return dist;\n}","new_string":"// D=12: 128-bit vectorized loads (LDG.128) reduce serial dependency chains.\n// Early exit at 4-dim granularity: 3 branches instead of 12.\n// Requires lhs 16-byte aligned — satisfied because each D=12 row is 48 bytes\n// (a multiple of 16) from a cudaMalloc-aligned base.\ntemplate <>\n__device__ float squaredDistance<12>(const float* __restrict__ lhs,\n                                     const float* __restrict__ rhs,\n                                     int /*runtime_dimension*/, float limit) {\n  const float4 l0 = *reinterpret_cast<const float4*>(lhs);\n  const float4 r0 = *reinterpret_cast<const float4*>(rhs);\n  float t;\n  t = l0.x - r0.x; float dist = t * t;\n  t = l0.y - r0.y; dist += t * t;\n  t = l0.z - r0.z; dist += t * t;\n  t = l0.w - r0.w; dist += t * t;\n  if (dist > limit) return dist;\n\n  const float4 l1 = *reinterpret_cast<const float4*>(lhs + 4);\n  const float4 r1 = *reinterpret_cast<const float4*>(rhs + 4);\n  t = l1.x - r1.x; dist += t * t;\n  t = l1.y - r1.y; dist += t * t;\n  t = l1.z - r1.z; dist += t * t;\n  t = l1.w - r1.w; dist += t * t;\n  if (dist > limit) return dist;\n\n  const float4 l2 = *reinterpret_cast<const float4*>(lhs + 8);\n  const float4 r2 = *reinterpret_cast<const float4*>(rhs + 8);\n  t = l2.x - r2.x; dist += t * t;\n  t = l2.y - r2.y; dist += t * t;\n  t = l2.z - r2.z; dist += t * t;\n  t = l2.w - r2.w; dist += t * t;\n  return dist;\n}"}}}
