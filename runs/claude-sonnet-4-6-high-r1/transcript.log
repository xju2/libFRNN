{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XQfpatf5XiwaUExxqeV6fL","type":"tool_result","content":"1\tcmake_minimum_required(VERSION 3.20)\n2\t\n3\tproject(libFRNN VERSION 1.0.0 LANGUAGES CXX CUDA)\n4\t\n5\tinclude(GNUInstallDirs)\n6\tinclude(CMakePackageConfigHelpers)\n7\t\n8\tfind_package(Git QUIET)\n9\tif(Git_FOUND)\n10\t    execute_process(\n11\t        COMMAND \"${GIT_EXECUTABLE}\" rev-parse --short=12 HEAD\n12\t        WORKING_DIRECTORY \"${CMAKE_CURRENT_SOURCE_DIR}\"\n13\t        OUTPUT_VARIABLE FRNN_GIT_COMMIT\n14\t        OUTPUT_STRIP_TRAILING_WHITESPACE\n15\t        ERROR_QUIET\n16\t    )\n17\tendif()\n18\tif(NOT FRNN_GIT_COMMIT)\n19\t    set(FRNN_GIT_COMMIT \"unknown\")\n20\tendif()\n21\t\n22\toption(BUILD_SHARED_LIBS \"Build shared libraries instead of static libraries\" ON)\n23\toption(FRNN_BUILD_TESTS \"Build FRNN tests\" ON)\n24\toption(FRNN_BUILD_BENCHMARKS \"Build FRNN benchmarks\" OFF)\n25\toption(FRNN_BUILD_PYTHON \"Build Python bindings\" OFF)\n26\t\n27\tfind_package(CUDAToolkit REQUIRED)\n28\t\n29\tadd_library(frnn src/frnn.cu)\n30\tadd_library(frnn::frnn ALIAS frnn)\n31\tset_target_properties(frnn PROPERTIES\n32\t    EXPORT_NAME frnn\n33\t    POSITION_INDEPENDENT_CODE ON\n34\t    CXX_STANDARD 17\n35\t    CXX_STANDARD_REQUIRED ON\n36\t    CUDA_STANDARD 17\n37\t    CUDA_STANDARD_REQUIRED ON\n38\t    CUDA_SEPARABLE_COMPILATION OFF\n39\t)\n40\ttarget_include_directories(frnn\n41\t    PUBLIC\n42\t        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/include>\n43\t        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>\n44\t)\n45\ttarget_link_libraries(frnn PUBLIC CUDA::cudart)\n46\ttarget_compile_options(frnn PRIVATE\n47\t    $<$<COMPILE_LANGUAGE:CXX>:-Wall;-Wextra;-Wpedantic>\n48\t    $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>\n49\t)\n50\t\n51\tinstall(TARGETS frnn\n52\t    EXPORT frnnTargets\n53\t    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}\n54\t    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}\n55\t