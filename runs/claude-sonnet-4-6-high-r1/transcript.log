{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YEJw76ZEtpkdd6wZ7Lj72E","type":"tool_result","content":"1\t#include <frnn/frnn.hpp>\n2\t\n3\t#include <cub/device/device_scan.cuh>\n4\t#include <cuda_runtime.h>\n5\t\n6\t#include <algorithm>\n7\t#include <cmath>\n8\t#include <cstdint>\n9\t#include <limits>\n10\t#include <sstream>\n11\t#include <stdexcept>\n12\t#include <utility>\n13\t\n14\tnamespace frnn {\n15\tnamespace {\n16\t\n17\t#if defined(FRNN_ENABLE_STAGE_PROFILING)\n18\tconstexpr int kProfileEventCount = 10;\n19\tthread_local cudaEvent_t* active_profile_events = nullptr;\n20\t#endif\n21\t\n22\tconstexpr int kGridDimensions = 4;\n23\tconstexpr int kMaximumGridResolution = 128;\n24\tconstexpr int kMaximumGridCells3D = 128 * 1024;\n25\tconstexpr int kMaximumGridCells4D = 128 * 128 * 128;\n26\tconstexpr int kThreads = 256;\n27\tconstexpr std::int64_t kBruteForceCoordinateWork = 2'000'000;\n28\t\n29\tstruct GridParameters {\n30\t  float minimum[kGridDimensions];\n31\t  float inverse_cell_size;\n32\t  int resolution[kGridDimensions];\n33\t  int total_cells;\n34\t  int grid_dimensions;\n35\t};\n36\t\n37\t[[noreturn]] void throwCuda(cudaError_t error, const char* operation) {\n38\t  std::ostringstream message;\n39\t  message << operation << \": \" << cudaGetErrorString(error);\n40\t  throw std::runtime_error(message.str());\n41\t}\n42\t\n43\tvoid checkCuda(cudaError_t error, const char* operation) {\n44\t  if (error != cudaSuccess) {\n45\t    throwCuda(error, operation);\n46\t  }\n47\t}\n48\t\n49\t#if defined(FRNN_ENABLE_STAGE_PROFILING)\n50\tvoid recordProfileEvent(int index, cudaStream_t stream) {\n51\t  if (active_profile_events != nullptr) {\n52\t    checkCuda(cudaEventRecord(active_profile_events[index], stream),\n53\t              \"record profiling event\");\n54\t  }\n55\t}\n56\t#else\n57\tvoid recordProfileEvent(int, cudaStream_t) {}\n58\t#endif\n59\t\n60\tint blocksFor(std::int64_t count) {\n61\t  if (count <= 0) {\n62\t    return 1;\n63\t  }\n64\t  return static_cast<int>(\n65\t      std::min<std::int64_t>((count + kThreads - 1) / kThreads, 65535));\n66\t}\n67\t\n68\tint gridDimensionCount(int dimension) {\n69\t  return dimension <= 4 ? std::min(dimension, 3) : kGridDimensions;\n70\t}\n71\t\n72\tint maximumGridCells(int dimension) {\n73\t  return gridDimensionCount(dimension) <= 3 ? kMaximumGridCells3D\n74\t                                            : kMaximumGridCells4D;\n75\t}\n76\t\n77\tvoid validateView(std::int64_t size, int dimension, const float* data,\n78\t                  const char* name) {\n79\t  if (size < 0) {\n80\t    throw std::invalid_argument(std::string(name) + \".size must be non-negative\");\n81\t  }\n82\t  if (dimension <= 0) {\n83\t    throw std::invalid_argument(std::string(name) +\n84\t                                \".dimension must be positive\");\n85\t  }\n86\t  if (dimension > 32) {\n87\t    throw std::invalid_argument(std::string(name) +\n88\t                                \".dimension must not exceed 32\");\n89\t  }\n90\t  if (size > 0 && data == nullptr) {\n91\t    throw std::invalid_argument(std::string(name) +\n92\t                                \".data must not be null for non-empty input\");\n93\t  }\n94\t  if (size > std::numeric_limits<int>::max()) {\n95\t    throw std::invalid_argument(std::string(name) +\n96\t                                \".size exceeds the supported CUDA index range\");\n97\t  }\n98\t}\n99\t\n100\tvoid validateConfiguration(float radius, int max_neighbors) {\n101\t  if (!std::isfinite(radius) || radius <= 0.0F) {\n102\t    throw std::invalid_argument(\"radius must be finite and greater than zero\");\n103\t  }\n104\t  if (max_neighbors < 0) {\n105\t    throw std::invalid_argument(\"max_neighbors must be non-negative\");\n106\t  }\n107\t}\n108\t\n109\tvoid validateHostValues(PointView view, const char* name) {\n110\t  validateView(view.size, view.dimension, view.data, name);\n111\t  const std::int64_t values = view.size * view.dimension;\n112\t  for (std::int64_t index = 0; index < values; ++index) {\n113\t    if (!std::isfinite(view.data[index])) {\n114\t      throw std::invalid_argument(std::string(name) +\n115\t                                  \" contains a non-finite coordinate\");\n116\t    }\n117\t  }\n118\t}\n119\t\n120\t__device__ float atomicMinimum(float* address, float value) {\n121\t  int* integer_address = reinterpret_cast<int*>(address);\n122\t  int old = *integer_address;\n123\t  while (value < __int_as_float(old)) {\n124\t    const int assumed = old;\n125\t    old = atomicCAS(integer_address, assumed, __float_as_int(value));\n126\t    if (old == assumed) {\n127\t      break;\n128\t    }\n129\t  }\n130\t  return __int_as_float(old);\n131\t}\n132\t\n133\t__device__ float atomicMaximum(float* address, float value) {\n134\t  int* integer_address = reinterpret_cast<int*>(address);\n135\t  int old = *integer_address;\n136\t  while (value > __int_as_float(old)) {\n137\t    const int assumed = old;\n138\t    old = atomicCAS(integer_address, assumed, __float_as_int(value));\n139\t    if (old == assumed) {\n140\t      break;\n141\t    }\n142\t  }\n143\t  return __int_as_float(old);\n144\t}\n145\t\n146\t__global__ void initializeBounds(float* bounds) {\n147\t  if (threadIdx.x < kGridDimensions) {\n148\t    bounds[threadIdx.x] = INFINITY;\n149\t    bounds[kGridDimensions + threadIdx.x] = -INFINITY;\n150\t  }\n151\t}\n152\t\n153\t__global__ void computeBounds(const float* points, int point_count,\n154\t                              int dimension, int grid_dimensions,\n155\t                              float* bounds) {\n156\t  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n157\t       point < point_count; point += blockDim.x * gridDim.x) {\n158\t    for (int axis = 0; axis < grid_dimensions; ++axis) {\n159\t      const float value = points[point * dimension + axis];\n160\t      atomicMinimum(&bounds[axis], value);\n161\t      atomicMaximum(&bounds[kGridDimensions + axis], value);\n162\t    }\n163\t  }\n164\t}\n165\t\n166\t__global__ void finalizeGrid(const float* bounds, int grid_dimensions,\n167\t                             int maximum_cells, float radius,\n168\t                             GridParameters* parameters) {\n169\t  if (blockIdx.x != 0 || threadIdx.x != 0) {\n170\t    return;\n171\t  }\n172\t\n173\t  float largest_extent = 0.0F;\n174\t  for (int axis = 0; axis < grid_dimensions; ++axis) {\n175\t    largest_extent =\n176\t        fmaxf(largest_extent,\n177\t              bounds[kGridDimensions + axis] - bounds[axis]);\n178\t  }\n179\t  const float radius_cell_size =\n180\t      radius * (grid_dimensions <= 3 ? 1.0F : 0.5F);\n181\t  float cell_size = fmaxf(radius_cell_size,\n182\t                          largest_extent /\n183\t                              static_cast<float>(kMaximumGridResolution - 1));\n184\t  if (!(cell_size > 0.0F) || !isfinite(cell_size)) {\n185\t    cell_size = radius_cell_size;\n186\t  }\n187\t\n188\t  int resolution[kGridDimensions] = {1, 1, 1, 1};\n189\t  int total_cells = 1;\n190\t  for (int attempt = 0; attempt < 8; ++attempt) {\n191\t    long long candidate_cells = 1;\n192\t    for (int axis = 0; axis < grid_dimensions; ++axis) {\n193\t      int axis_resolution = static_cast<int>(\n194\t                                floorf((bounds[kGridDimensions + axis] -\n195\t                                        bounds[axis]) /\n196\t                                       cell_size)) +\n197\t                            1;\n198\t      axis_resolution =\n199\t          max(1, min(kMaximumGridResolution, axis_resolution));\n200\t      resolution[axis] = axis_resolution;\n201\t      candidate_cells *= axis_resolution;\n202\t    }\n203\t    if (candidate_cells <= maximum_cells) {\n204\t      total_cells = static_cast<int>(candidate_cells);\n205\t      break;\n206\t    }\n207\t    const float scale =\n208\t        powf(static_cast<float>(candidate_cells) /\n209\t                 static_cast<float>(maximum_cells),\n210\t             1.0F / static_cast<float>(grid_dimensions));\n211\t    cell_size *= fmaxf(1.01F, scale * 1.01F);\n212\t  }\n213\t\n214\t  parameters->inverse_cell_size = 1.0F / cell_size;\n215\t  parameters->grid_dimensions = grid_dimensions;\n216\t  parameters->total_cells = total_cells;\n217\t  for (int axis = 0; axis < kGridDimensions; ++axis) {\n218\t    if (axis < grid_dimensions) {\n219\t      parameters->minimum[axis] = bounds[axis];\n220\t      parameters->resolution[axis] = resolution[axis];\n221\t    } else {\n222\t      parameters->minimum[axis] = 0.0F;\n223\t      parameters->resolution[axis] = 1;\n224\t    }\n225\t  }\n226\t}\n227\t\n228\t__global__ void insertPoints(const float* points, int point_count,\n229\t                             int dimension,\n230\t                             const GridParameters* parameters,\n231\t                             int* grid_counts, int* point_cells,\n232\t                             int* point_cell_indices) {\n233\t  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n234\t       point < point_count; point += blockDim.x * gridDim.x) {\n235\t    int coordinate[kGridDimensions] = {0, 0, 0, 0};\n236\t    for (int axis = 0; axis < parameters->grid_dimensions; ++axis) {\n237\t      coordinate[axis] = static_cast<int>(\n238\t          floorf((points[point * dimension + axis] -\n239\t                  parameters->minimum[axis]) *\n240\t                 parameters->inverse_cell_size));\n241\t      coordinate[axis] =\n242\t          max(0, min(parameters->resolution[axis] - 1, coordinate[axis]));\n243\t    }\n244\t    const int cell =\n245\t        ((coordinate[0] * parameters->resolution[1] + coordinate[1]) *\n246\t                 parameters->resolution[2] +\n247\t             coordinate[2]) *\n248\t            parameters->resolution[3] +\n249\t        coordinate[3];\n250\t    point_cells[point] = cell;\n251\t    point_cell_indices[point] = atomicAdd(&grid_counts[cell], 1);\n252\t  }\n253\t}\n254\t\n255\t__global__ void countingSort(const float* points, int point_count,\n256\t                             int dimension, const int* point_cells,\n257\t                             const int* point_cell_indices,\n258\t                             const int* grid_offsets, float* sorted_points,\n259\t                             int* sorted_indices) {\n260\t  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n261\t       point < point_count; point += blockDim.x * gridDim.x) {\n262\t    const int destination =\n263\t        grid_offsets[point_cells[point]] + point_cell_indices[point];\n264\t    for (int axis = 0; axis < dimension; ++axis) {\n265\t      sorted_points[destination * dimension + axis] =\n266\t          points[point * dimension + axis];\n267\t    }\n268\t    sorted_indices[destination] = point;\n269\t  }\n270\t}\n271\t\n272\t__device__ bool precedes(float lhs_distance, std::int64_t lhs_index,\n273\t                         float rhs_distance, std::int64_t rhs_index) {\n274\t  return lhs_distance < rhs_distance ||\n275\t         (lhs_distance == rhs_distance && lhs_index < rhs_index);\n276\t}\n277\t\n278\t__device__ void insertNeighbor(float distance, int database_index,\n279\t                               int max_neighbors, int& found,\n280\t                               float* distances, int* indices) {\n281\t  int insertion = min(found, max_neighbors);\n282\t  while (insertion > 0 &&\n283\t         precedes(distance, database_index, distances[insertion - 1],\n284\t                  indices[insertion - 1])) {\n285\t    --insertion;\n286\t  }\n287\t  if (insertion >= max_neighbors) {\n288\t    return;\n289\t  }\n290\t  const int last = min(found, max_neighbors - 1);\n291\t  for (int position = last; position > insertion; --position) {\n292\t    distances[position] = distances[position - 1];\n293\t    indices[position] = indices[position - 1];\n294\t  }\n295\t  distances[insertion] = distance;\n296\t  indices[insertion] = database_index;\n297\t  found = min(found + 1, max_neighbors);\n298\t}\n299\t\n300\t__device__ bool follows(float lhs_distance, int lhs_index,\n301\t                        float rhs_distance, int rhs_index) {\n302\t  return precedes(rhs_distance, rhs_index, lhs_distance, lhs_index);\n303\t}\n304\t\n305\t__device__ void swapNeighbor(float* distances, int* indices, int lhs,\n306\t                             int rhs) {\n307\t  const float distance = distances[lhs];\n308\t  const int index = indices[lhs];\n309\t  distances[lhs] = distances[rhs];\n310\t  indices[lhs] = indices[rhs];\n311\t  distances[rhs] = distance;\n312\t  indices[rhs] = index;\n313\t}\n314\t\n315\t__device__ void siftNeighborDown(float* distances, int* indices, int count,\n316\t                                 int root) {\n317\t  while (true) {\n318\t    const int left = root * 2 + 1;\n319\t    if (left >= count) {\n320\t      return;\n321\t    }\n322\t    int worst = left;\n323\t    const int right = left + 1;\n324\t    if (right < count &&\n325\t        follows(distances[right], indices[right], distances[left],\n326\t                indices[left])) {\n327\t      worst = right;\n328\t    }\n329\t    if (!follows(distances[worst], indices[worst], distances[root],\n330\t                 indices[root])) {\n331\t      return;\n332\t    }\n333\t    swapNeighbor(distances, indices, root, worst);\n334\t    root = worst;\n335\t  }\n336\t}\n337\t\n338\t__device__ void insertNeighborHeap(float distance, int database_index,\n339\t                                   int max_neighbors, int& found,\n340\t                                   float* distances, int* indices) {\n341\t  if (found < max_neighbors) {\n342\t    int position = found++;\n343\t    distances[position] = distance;\n344\t    indices[position] = database_index;\n345\t    while (position > 0) {\n346\t      const int parent = (position - 1) / 2;\n347\t      if (!follows(distances[position], indices[position],\n348\t                   distances[parent], indices[parent])) {\n349\t        break;\n350\t      }\n351\t      swapNeighbor(distances, indices, position, parent);\n352\t      position = parent;\n353\t    }\n354\t    return;\n355\t  }\n356\t  if (!precedes(distance, database_index, distances[0], indices[0])) {\n357\t    return;\n358\t  }\n359\t  distances[0] = distance;\n360\t  indices[0] = database_index;\n361\t  siftNeighborDown(distances, indices, found, 0);\n362\t}\n363\t\n364\t__device__ void sortNeighborHeap(float* distances, int* indices, int count) {\n365\t  for (int end = count - 1; end > 0; --end) {\n366\t    swapNeighbor(distances, indices, 0, end);\n367\t    siftNeighborDown(distances, indices, end, 0);\n368\t  }\n369\t}\n370\t\n371\t__device__ void buildNeighborHeap(float* distances, int* indices, int count) {\n372\t  for (int root = count / 2 - 1; root >= 0; --root) {\n373\t    siftNeighborDown(distances, indices, count, root);\n374\t  }\n375\t}\n376\t\n377\t__device__ void selectNeighbor(float distance, int database_index,\n378\t                               int max_neighbors, int& found, bool& heap_mode,\n379\t                               float* distances, int* indices) {\n380\t  if (max_neighbors >= 64 && (heap_mode || found >= 24)) {\n381\t    if (!heap_mode) {\n382\t      buildNeighborHeap(distances, indices, found);\n383\t      heap_mode = true;\n384\t    }\n385\t    insertNeighborHeap(distance, database_index, max_neighbors, found,\n386\t                       distances, indices);\n387\t  } else {\n388\t    insertNeighbor(distance, database_index, max_neighbors, found, distances,\n389\t                   indices);\n390\t  }\n391\t}\n392\t\n393\ttemplate <int StaticDimension>\n394\t__device__ float squaredDistance(const float* lhs, const float* rhs,\n395\t                                 int runtime_dimension, float limit) {\n396\t  const int dimension =\n397\t      StaticDimension == 0 ? runtime_dimension : StaticDimension;\n398\t  float distance = 0.0F;\n399\t#pragma unroll\n400\t  for (int axis = 0; axis < dimension; ++axis) {\n401\t    const float difference = lhs[axis] - rhs[axis];\n402\t    distance += difference * difference;\n403\t    if (distance > limit) {\n404\t      break;\n405\t    }\n406\t  }\n407\t  return distance;\n408\t}\n409\t\n410\ttemplate <int StaticDimension>\n411\t__global__ void findNeighborsBruteForce(\n412\t    const float* query, int query_count, const float* database,\n413\t    int database_count, int dimension, float radius, int max_neighbors,\n414\t    bool exclude_self, bool inputs_are_same, float* neighbor_distances,\n415\t    int* neighbor_indices) {\n416\t  const float radius_squared = radius * radius;\n417\t  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n418\t       query_index < query_count;\n419\t       query_index += blockDim.x * gridDim.x) {\n420\t    const float* query_point = query + query_index * dimension;\n421\t    float cached_query[StaticDimension == 0 ? 1 : StaticDimension];\n422\t    if constexpr (StaticDimension != 0) {\n423\t#pragma unroll\n424\t      for (int axis = 0; axis < StaticDimension; ++axis) {\n425\t        cached_query[axis] = query_point[axis];\n426\t      }\n427\t      query_point = cached_query;\n428\t    }\n429\t    float* distances =\n430\t        neighbor_distances + static_cast<std::int64_t>(query_index) *\n431\t                                 max_neighbors;\n432\t    int* indices =\n433\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n434\t                               max_neighbors;\n435\t    int found = 0;\n436\t    bool heap_mode = false;\n437\t\n438\t    for (int database_index = 0; database_index < database_count;\n439\t         ++database_index) {\n440\t      if (exclude_self && inputs_are_same &&\n441\t          database_index == query_index) {\n442\t        continue;\n443\t      }\n444\t      const float distance = squaredDistance<StaticDimension>(\n445\t          database + database_index * dimension,\n446\t          query_point, dimension, radius_squared);\n447\t      if (distance <= radius_squared) {\n448\t        selectNeighbor(distance, database_index, max_neighbors, found,\n449\t                       heap_mode, distances, indices);\n450\t      }\n451\t    }\n452\t    if (heap_mode) {\n453\t      sortNeighborHeap(distances, indices, found);\n454\t    }\n455\t    if (found < max_neighbors) {\n456\t      indices[found] = -1;\n457\t    }\n458\t  }\n459\t}\n460\t\n461\ttemplate <int StaticDimension>\n462\t__global__ void findNeighbors(\n463\t    const float* query, int query_count, const float* sorted_database,\n464\t    const int* sorted_database_indices, int database_count, int dimension,\n465\t    const GridParameters* parameters, const int* grid_offsets, float radius,\n466\t    int max_neighbors, bool exclude_self, bool inputs_are_same,\n467\t    const int* query_indices, float* neighbor_distances,\n468\t    int* neighbor_indices) {\n469\t  const float radius_squared = radius * radius;\n470\t  for (int work_index = blockIdx.x * blockDim.x + threadIdx.x;\n471\t       work_index < query_count;\n472\t       work_index += blockDim.x * gridDim.x) {\n473\t    const int query_index =\n474\t        query_indices == nullptr ? work_index : query_indices[work_index];\n475\t    const float* query_point = query + work_index * dimension;\n476\t    float cached_query[StaticDimension == 0 ? 1 : StaticDimension];\n477\t    if constexpr (StaticDimension != 0) {\n478\t#pragma unroll\n479\t      for (int axis = 0; axis < StaticDimension; ++axis) {\n480\t        cached_query[axis] = query_point[axis];\n481\t      }\n482\t      query_point = cached_query;\n483\t    }\n484\t    float* distances =\n485\t        neighbor_distances + static_cast<std::int64_t>(query_index) *\n486\t                                 max_neighbors;\n487\t    int* indices =\n488\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n489\t                               max_neighbors;\n490\t    int found = 0;\n491\t    bool heap_mode = false;\n492\t\n493\t    int minimum_cell[kGridDimensions] = {0, 0, 0, 0};\n494\t    int maximum_cell[kGridDimensions] = {0, 0, 0, 0};\n495\t    for (int axis = 0; axis < parameters->grid_dimensions; ++axis) {\n496\t      const float coordinate = query_point[axis];\n497\t      minimum_cell[axis] = max(\n498\t          0, static_cast<int>(floorf(\n499\t                 (coordinate - parameters->minimum[axis] - radius) *\n500\t                 parameters->inverse_cell_size)));\n501\t      maximum_cell[axis] =\n502\t          min(parameters->resolution[axis] - 1,\n503\t              static_cast<int>(floorf(\n504\t                  (coordinate - parameters->minimum[axis] + radius) *\n505\t                  parameters->inverse_cell_size)));\n506\t    }\n507\t\n508\t    for (int x = minimum_cell[0]; x <= maximum_cell[0]; ++x) {\n509\t      for (int y = minimum_cell[1]; y <= maximum_cell[1]; ++y) {\n510\t        for (int z = minimum_cell[2]; z <= maximum_cell[2]; ++z) {\n511\t          for (int w = minimum_cell[3]; w <= maximum_cell[3]; ++w) {\n512\t            const int cell =\n513\t                ((x * parameters->resolution[1] + y) *\n514\t                         parameters->resolution[2] +\n515\t                     z) *\n516\t                    parameters->resolution[3] +\n517\t                w;\n518\t            const int begin = grid_offsets[cell];\n519\t            const int end =\n520\t                cell + 1 < parameters->total_cells\n521\t                    ? grid_offsets[cell + 1]\n522\t                    : database_count;\n523\t            for (int sorted_index = begin; sorted_index < end;\n524\t                 ++sorted_index) {\n525\t              const int database_index =\n526\t                  sorted_database_indices[sorted_index];\n527\t              if (exclude_self && inputs_are_same &&\n528\t                  database_index == query_index) {\n529\t                continue;\n530\t              }\n531\t\n532\t              const float distance = squaredDistance<StaticDimension>(\n533\t                  sorted_database + sorted_index * dimension,\n534\t                  query_point, dimension, radius_squared);\n535\t              if (distance > radius_squared) {\n536\t                continue;\n537\t              }\n538\t\n539\t              selectNeighbor(distance, database_index, max_neighbors, found,\n540\t                             heap_mode, distances, indices);\n541\t            }\n542\t          }\n543\t        }\n544\t      }\n545\t    }\n546\t    if (heap_mode) {\n547\t      sortNeighborHeap(distances, indices, found);\n548\t    }\n549\t    if (found < max_neighbors) {\n550\t      indices[found] = -1;\n551\t    }\n552\t  }\n553\t}\n554\t\n555\tvoid launchBruteForceNeighbors(\n556\t    const float* query, int query_count, const float* database,\n557\t    int database_count, int dimension, float radius, int max_neighbors,\n558\t    bool exclude_self, bool inputs_are_same, float* neighbor_distances,\n559\t    int* neighbor_indices, cudaStream_t stream) {\n560\t  const int blocks = blocksFor(query_count);\n561\t#define FRNN_LAUNCH_BRUTE_FORCE(Dimension)                                  \\\n562\t  findNeighborsBruteForce<Dimension>                                       \\\n563\t      <<<blocks, kThreads, 0, stream>>>(                                   \\\n564\t          query, query_count, database, database_count, dimension, radius, \\\n565\t          max_neighbors, exclude_self, inputs_are_same,                    \\\n566\t          neighbor_distances, neighbor_indices)\n567\t  switch (dimension) {\n568\t    case 1:\n569\t      FRNN_LAUNCH_BRUTE_FORCE(1);\n570\t      break;\n571\t    case 2:\n572\t      FRNN_LAUNCH_BRUTE_FORCE(2);\n573\t      break;\n574\t    case 3:\n575\t      FRNN_LAUNCH_BRUTE_FORCE(3);\n576\t      break;\n577\t    case 4:\n578\t      FRNN_LAUNCH_BRUTE_FORCE(4);\n579\t      break;\n580\t    case 8:\n581\t      FRNN_LAUNCH_BRUTE_FORCE(8);\n582\t      break;\n583\t    case 12:\n584\t      FRNN_LAUNCH_BRUTE_FORCE(12);\n585\t      break;\n586\t    case 16:\n587\t      FRNN_LAUNCH_BRUTE_FORCE(16);\n588\t      break;\n589\t    default:\n590\t      FRNN_LAUNCH_BRUTE_FORCE(0);\n591\t      break;\n592\t  }\n593\t#undef FRNN_LAUNCH_BRUTE_FORCE\n594\t}\n595\t\n596\tvoid launchGridNeighbors(\n597\t    const float* query, int query_count, const float* sorted_database,\n598\t    const int* sorted_database_indices, int database_count, int dimension,\n599\t    const GridParameters* parameters, const int* grid_offsets, float radius,\n600\t    int max_neighbors, bool exclude_self, bool inputs_are_same,\n601\t    const int* query_indices, float* neighbor_distances,\n602\t    int* neighbor_indices, cudaStream_t stream) {\n603\t  const int blocks = blocksFor(query_count);\n604\t#define FRNN_LAUNCH_GRID(Dimension)                                        \\\n605\t  findNeighbors<Dimension><<<blocks, kThreads, 0, stream>>>(               \\\n606\t      query, query_count, sorted_database, sorted_database_indices,        \\\n607\t      database_count, dimension, parameters, grid_offsets, radius,         \\\n608\t      max_neighbors, exclude_self, inputs_are_same, query_indices,         \\\n609\t      neighbor_distances, neighbor_indices)\n610\t  switch (dimension) {\n611\t    case 1:\n612\t      FRNN_LAUNCH_GRID(1);\n613\t      break;\n614\t    case 2:\n615\t      FRNN_LAUNCH_GRID(2);\n616\t      break;\n617\t    case 3:\n618\t      FRNN_LAUNCH_GRID(3);\n619\t      break;\n620\t    case 4:\n621\t      FRNN_LAUNCH_GRID(4);\n622\t      break;\n623\t    case 8:\n624\t      FRNN_LAUNCH_GRID(8);\n625\t      break;\n626\t    case 12:\n627\t      FRNN_LAUNCH_GRID(12);\n628\t      break;\n629\t    case 16:\n630\t      FRNN_LAUNCH_GRID(16);\n631\t      break;\n632\t    default:\n633\t      FRNN_LAUNCH_GRID(0);\n634\t      break;\n635\t  }\n636\t#undef FRNN_LAUNCH_GRID\n637\t}\n638\t\n639\t__global__ void countEdges(const int* neighbor_indices,\n640\t                           int query_count, int max_neighbors,\n641\t                           bool undirected, std::int64_t* edge_counts) {\n642\t  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n643\t       query_index < query_count;\n644\t       query_index += blockDim.x * gridDim.x) {\n645\t    std::int64_t count = 0;\n646\t    const int* neighbors =\n647\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n648\t                               max_neighbors;\n649\t    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n650\t      const int target = neighbors[neighbor];\n651\t      if (target < 0) {\n652\t        break;\n653\t      }\n654\t      if (!undirected || query_index > target) {\n655\t        ++count;\n656\t      }\n657\t    }\n658\t    edge_counts[query_index] = count;\n659\t  }\n660\t}\n661\t\n662\t__global__ void writeEdges(const int* neighbor_indices,\n663\t                           int query_count, int max_neighbors,\n664\t                           bool undirected,\n665\t                           const std::int64_t* edge_offsets,\n666\t                           std::int64_t* edges) {\n667\t  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n668\t       query_index < query_count;\n669\t       query_index += blockDim.x * gridDim.x) {\n670\t    std::int64_t output_index = edge_offsets[query_index];\n671\t    const int* neighbors =\n672\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n673\t                               max_neighbors;\n674\t    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n675\t      const int target = neighbors[neighbor];\n676\t      if (target < 0) {\n677\t        break;\n678\t      }\n679\t      if (!undirected || query_index > target) {\n680\t        edges[output_index * 2] = query_index;\n681\t        edges[output_index * 2 + 1] = target;\n682\t        ++output_index;\n683\t      }\n684\t    }\n685\t  }\n686\t}\n687\t\n688\ttemplate <typename T>\n689\tvoid allocateDevice(T** pointer, std::size_t count, const char* name) {\n690\t  if (count == 0) {\n691\t    *pointer = nullptr;\n692\t    return;\n693\t  }\n694\t  checkCuda(cudaMalloc(reinterpret_cast<void**>(pointer), count * sizeof(T)),\n695\t            name);\n696\t}\n697\t\n698\ttemplate <typename T>\n699\tvoid freeDevice(T*& pointer) noexcept {\n700\t  if (pointer != nullptr) {\n701\t    cudaFree(pointer);\n702\t    pointer = nullptr;\n703\t  }\n704\t}\n705\t\n706\tSearchAlgorithm resolveAlgorithm(SearchAlgorithm requested,\n707\t                                 std::int64_t query_count,\n708\t                                 std::int64_t database_count, int dimension,\n709\t                                 int max_neighbors) {\n710\t  if (requested != SearchAlgorithm::automatic) {\n711\t    return requested;\n712\t  }\n713\t  if (query_count == 0 || database_count == 0) {\n714\t    return SearchAlgorithm::brute_force;\n715\t  }\n716\t  const std::int64_t database_dimensions =\n717\t      database_count > kBruteForceCoordinateWork / dimension\n718\t          ? kBruteForceCoordinateWork + 1\n719\t          : database_count * dimension;\n720\t  const std::int64_t selection_factor =\n721\t      std::max<std::int64_t>(1, (max_neighbors + 7) / 8);\n722\t  if (database_dimensions > kBruteForceCoordinateWork / selection_factor) {\n723\t    return SearchAlgorithm::grid;\n724\t  }\n725\t  const std::int64_t work_per_query =\n726\t      database_dimensions * selection_factor;\n727\t  const bool fits =\n728\t      query_count <= kBruteForceCoordinateWork / work_per_query;\n729\t  return fits ? SearchAlgorithm::brute_force : SearchAlgorithm::grid;\n730\t}\n731\t\n732\t}  // namespace\n733\t\n734\tstruct Workspace::Impl {\n735\t  int device = -1;\n736\t  std::int64_t query_capacity = 0;\n737\t  std::int64_t database_capacity = 0;\n738\t  int dimension_capacity = 0;\n739\t  int neighbor_capacity = 0;\n740\t  bool has_grid_storage = false;\n741\t  int grid_cell_capacity = 0;\n742\t\n743\t  float* bounds = nullptr;\n744\t  GridParameters* grid_parameters = nullptr;\n745\t  int* grid_counts = nullptr;\n746\t  int* grid_offsets = nullptr;\n747\t  int* point_cells = nullptr;\n748\t  int* point_cell_indices = nullptr;\n749\t  float* sorted_database = nullptr;\n750\t  int* sorted_database_indices = nullptr;\n751\t  float* neighbor_distances = nullptr;\n752\t  int* neighbor_indices = nullptr;\n753\t  std::int64_t* edge_counts = nullptr;\n754\t  std::int64_t* edge_offsets = nullptr;\n755\t  void* scan_temporary = nullptr;\n756\t  std::size_t scan_temporary_bytes = 0;\n757\t};\n758\t\n759\tWorkspace::Workspace() : impl_(std::make_unique<Impl>()) {}\n760\tWorkspace::~Workspace() { clear(); }\n761\tWorkspace::Workspace(Workspace&&) noexcept = default;\n762\tWorkspace& Workspace::operator=(Workspace&& other) noexcept {\n763\t  if (this != &other) {\n764\t    clear();\n765\t    impl_ = std::move(other.impl_);\n766\t  }\n767\t  return *this;\n768\t}\n769\t\n770\tvoid Workspace::clear() noexcept {\n771\t  if (!impl_) {\n772\t    return;\n773\t  }\n774\t  int original_device = -1;\n775\t  cudaGetDevice(&original_device);\n776\t  if (impl_->device >= 0 && impl_->device != original_device) {\n777\t    cudaSetDevice(impl_->device);\n778\t  }\n779\t  freeDevice(impl_->bounds);\n780\t  freeDevice(impl_->grid_parameters);\n781\t  freeDevice(impl_->grid_counts);\n782\t  freeDevice(impl_->grid_offsets);\n783\t  freeDevice(impl_->point_cells);\n784\t  freeDevice(impl_->point_cell_indices);\n785\t  freeDevice(impl_->sorted_database);\n786\t  freeDevice(impl_->sorted_database_indices);\n787\t  freeDevice(impl_->neighbor_distances);\n788\t  freeDevice(impl_->neighbor_indices);\n789\t  freeDevice(impl_->edge_counts);\n790\t  freeDevice(impl_->edge_offsets);\n791\t  if (impl_->scan_temporary != nullptr) {\n792\t    cudaFree(impl_->scan_temporary);\n793\t    impl_->scan_temporary = nullptr;\n794\t  }\n795\t  if (impl_->device >= 0 && impl_->device != original_device &&\n796\t      original_device >= 0) {\n797\t    cudaSetDevice(original_device);\n798\t  }\n799\t  *impl_ = Impl{};\n800\t}\n801\t\n802\tvoid Workspace::reserve(std::int64_t max_query_points,\n803\t                        std::int64_t max_database_points, int dimension,\n804\t                        int max_neighbors, SearchAlgorithm algorithm) {\n805\t  validateView(max_query_points, dimension,\n806\t               max_query_points == 0 ? nullptr\n807\t                                     : reinterpret_cast<const float*>(1),\n808\t               \"max_query_points\");\n809\t  validateView(max_database_points, dimension,\n810\t               max_database_points == 0 ? nullptr\n811\t                                        : reinterpret_cast<const float*>(1),\n812\t               \"max_database_points\");\n813\t  if (max_neighbors < 0) {\n814\t    throw std::invalid_argument(\"max_neighbors must be non-negative\");\n815\t  }\n816\t  requiredEdgeCapacity(max_query_points, max_neighbors);\n817\t  const SearchAlgorithm resolved_algorithm =\n818\t      resolveAlgorithm(algorithm, max_query_points, max_database_points,\n819\t                       dimension, max_neighbors);\n820\t  const bool needs_grid_storage =\n821\t      resolved_algorithm == SearchAlgorithm::grid;\n822\t  const int required_grid_cells =\n823\t      needs_grid_storage ? maximumGridCells(dimension) : 0;\n824\t\n825\t  int current_device = -1;\n826\t  checkCuda(cudaGetDevice(&current_device), \"cudaGetDevice\");\n827\t  if (impl_->device == current_device &&\n828\t      impl_->query_capacity >= max_query_points &&\n829\t      impl_->database_capacity >= max_database_points &&\n830\t      impl_->dimension_capacity >= dimension &&\n831\t      impl_->neighbor_capacity >= max_neighbors &&\n832\t      (!needs_grid_storage ||\n833\t       (impl_->has_grid_storage &&\n834\t        impl_->grid_cell_capacity >= required_grid_cells))) {\n835\t    return;\n836\t  }\n837\t\n838\t  const std::int64_t query_capacity =\n839\t      std::max(impl_->query_capacity, max_query_points);\n840\t  const std::int64_t database_capacity =\n841\t      std::max(impl_->database_capacity, max_database_points);\n842\t  const int dimension_capacity =\n843\t      std::max(impl_->dimension_capacity, dimension);\n844\t  const int neighbor_capacity =\n845\t      std::max(impl_->neighbor_capacity, max_neighbors);\n846\t  clear();\n847\t  impl_->device = current_device;\n848\t  impl_->query_capacity = query_capacity;\n849\t  impl_->database_capacity = database_capacity;\n850\t  impl_->dimension_capacity = dimension_capacity;\n851\t  impl_->neighbor_capacity = neighbor_capacity;\n852\t  impl_->has_grid_storage = needs_grid_storage;\n853\t  impl_->grid_cell_capacity = required_grid_cells;\n854\t\n855\t  try {\n856\t    if (needs_grid_storage) {\n857\t      allocateDevice(&impl_->bounds, 2 * kGridDimensions, \"allocate bounds\");\n858\t      allocateDevice(&impl_->grid_parameters, 1, \"allocate grid parameters\");\n859\t      allocateDevice(&impl_->grid_counts, required_grid_cells,\n860\t                     \"allocate grid counts\");\n861\t      allocateDevice(&impl_->grid_offsets, required_grid_cells,\n862\t                     \"allocate grid offsets\");\n863\t      allocateDevice(&impl_->point_cells,\n864\t                     static_cast<std::size_t>(database_capacity),\n865\t                     \"allocate point cells\");\n866\t      allocateDevice(&impl_->point_cell_indices,\n867\t                     static_cast<std::size_t>(database_capacity),\n868\t                     \"allocate point cell indices\");\n869\t      allocateDevice(\n870\t          &impl_->sorted_database,\n871\t          static_cast<std::size_t>(database_capacity) * dimension_capacity,\n872\t          \"allocate sorted database\");\n873\t      allocateDevice(&impl_->sorted_database_indices,\n874\t                     static_cast<std::size_t>(database_capacity),\n875\t                     \"allocate sorted database indices\");\n876\t    }\n877\t    const std::size_t neighbor_values =\n878\t        static_cast<std::size_t>(query_capacity) * neighbor_capacity;\n879\t    allocateDevice(&impl_->neighbor_distances, neighbor_values,\n880\t                   \"allocate neighbor distances\");\n881\t    allocateDevice(&impl_->neighbor_indices, neighbor_values,\n882\t                   \"allocate neighbor indices\");\n883\t    allocateDevice(&impl_->edge_counts,\n884\t                   static_cast<std::size_t>(query_capacity) + 1,\n885\t                   \"allocate edge counts\");\n886\t    allocateDevice(&impl_->edge_offsets,\n887\t                   static_cast<std::size_t>(query_capacity) + 1,\n888\t                   \"allocate edge offsets\");\n889\t\n890\t    std::size_t grid_scan_bytes = 0;\n891\t    if (needs_grid_storage) {\n892\t      checkCuda(cub::DeviceScan::ExclusiveSum(\n893\t                    nullptr, grid_scan_bytes, impl_->grid_counts,\n894\t                    impl_->grid_offsets, required_grid_cells),\n895\t                \"size grid prefix-sum workspace\");\n896\t    }\n897\t    std::size_t edge_scan_bytes = 0;\n898\t    checkCuda(cub::DeviceScan::ExclusiveSum(\n899\t                  nullptr, edge_scan_bytes, impl_->edge_counts,\n900\t                  impl_->edge_offsets,\n901\t                  static_cast<int>(query_capacity + 1)),\n902\t              \"size edge prefix-sum workspace\");\n903\t    impl_->scan_temporary_bytes =\n904\t        std::max(grid_scan_bytes, edge_scan_bytes);\n905\t    checkCuda(cudaMalloc(&impl_->scan_temporary,\n906\t                         impl_->scan_temporary_bytes),\n907\t              \"allocate prefix-sum workspace\");\n908\t  } catch (...) {\n909\t    clear();\n910\t    throw;\n911\t  }\n912\t}\n913\t\n914\tstd::int64_t requiredEdgeCapacity(std::int64_t query_points,\n915\t                                  int max_neighbors) {\n916\t  if (query_points < 0 || max_neighbors < 0) {\n917\t    throw std::invalid_argument(\n918\t        \"query_points and max_neighbors must be non-negative\");\n919\t  }\n920\t  if (max_neighbors != 0 &&\n921\t      query_points >\n922\t          std::numeric_limits<std::int64_t>::max() / max_neighbors) {\n923\t    throw std::overflow_error(\"edge capacity exceeds int64 range\");\n924\t  }\n925\t  return query_points * max_neighbors;\n926\t}\n927\t\n928\tvoid buildEdgesAsync(DevicePointView query, DevicePointView database,\n929\t                     DeviceEdgeBuffer output, float radius, int max_neighbors,\n930\t                     BuildOptions options, Workspace& workspace,\n931\t                     cudaStream_t stream) {\n932\t  validateView(query.size, query.dimension, query.data, \"query\");\n933\t  validateView(database.size, database.dimension, database.data, \"database\");\n934\t  if (query.dimension != database.dimension) {\n935\t    throw std::invalid_argument(\n936\t        \"query and database dimensions must be identical\");\n937\t  }\n938\t  validateConfiguration(radius, max_neighbors);\n939\t  const std::int64_t required_capacity =\n940\t      requiredEdgeCapacity(query.size, max_neighbors);\n941\t  if (output.edge_count == nullptr) {\n942\t    throw std::invalid_argument(\"output.edge_count must not be null\");\n943\t  }\n944\t  const bool count_only = output.edges == nullptr;\n945\t  if (!count_only && output.capacity < required_capacity) {\n946\t    throw std::invalid_argument(\n947\t        \"output.capacity is smaller than requiredEdgeCapacity\");\n948\t  }\n949\t  if (options.undirected && !options.inputs_are_same) {\n950\t    throw std::invalid_argument(\n951\t        \"undirected output requires inputs_are_same=true\");\n952\t  }\n953\t  if (options.inputs_are_same && query.size != database.size) {\n954\t    throw std::invalid_argument(\n955\t        \"inputs_are_same requires equal query and database sizes\");\n956\t  }\n957\t\n958\t  if (query.size == 0 || database.size == 0 || max_neighbors == 0) {\n959\t    checkCuda(cudaMemsetAsync(output.edge_count, 0, sizeof(std::int64_t),\n960\t                              stream),\n961\t              \"clear edge count\");\n962\t    return;\n963\t  }\n964\t\n965\t  const SearchAlgorithm algorithm =\n966\t      resolveAlgorithm(options.algorithm, query.size, database.size,\n967\t                       query.dimension, max_neighbors);\n968\t  workspace.reserve(query.size, database.size, query.dimension,\n969\t                    max_neighbors, algorithm);\n970\t  Workspace::Impl& memory = *workspace.impl_;\n971\t  const int query_count = static_cast<int>(query.size);\n972\t  const int database_count = static_cast<int>(database.size);\n973\t  const int grid_cell_capacity = maximumGridCells(query.dimension);\n974\t  recordProfileEvent(0, stream);\n975\t  if (algorithm == SearchAlgorithm::brute_force) {\n976\t    for (int event = 1; event <= 4; ++event) {\n977\t      recordProfileEvent(event, stream);\n978\t    }\n979\t    launchBruteForceNeighbors(\n980\t        query.data, query_count, database.data, database_count,\n981\t        query.dimension, radius, max_neighbors, options.exclude_self,\n982\t        options.inputs_are_same, memory.neighbor_distances,\n983\t        memory.neighbor_indices, stream);\n984\t    checkCuda(cudaPeekAtLastError(), \"launch findNeighborsBruteForce\");\n985\t  } else {\n986\t    const int grid_dimensions = gridDimensionCount(query.dimension);\n987\t    initializeBounds<<<1, kGridDimensions, 0, stream>>>(memory.bounds);\n988\t    checkCuda(cudaPeekAtLastError(), \"launch initializeBounds\");\n989\t    computeBounds<<<blocksFor(database.size), kThreads, 0, stream>>>(\n990\t        database.data, database_count, database.dimension, grid_dimensions,\n991\t        memory.bounds);\n992\t    checkCuda(cudaPeekAtLastError(), \"launch computeBounds\");\n993\t    finalizeGrid<<<1, 1, 0, stream>>>(\n994\t        memory.bounds, grid_dimensions, grid_cell_capacity, radius,\n995\t        memory.grid_parameters);\n996\t    checkCuda(cudaPeekAtLastError(), \"launch finalizeGrid\");\n997\t    recordProfileEvent(1, stream);\n998\t\n999\t    checkCuda(cudaMemsetAsync(memory.grid_counts, 0,\n1000\t                              grid_cell_capacity * sizeof(int), stream),\n1001\t              \"clear grid counts\");\n1002\t    insertPoints<<<blocksFor(database.size), kThreads, 0, stream>>>(\n1003\t        database.data, database_count, database.dimension,\n1004\t        memory.grid_parameters, memory.grid_counts, memory.point_cells,\n1005\t        memory.point_cell_indices);\n1006\t    checkCuda(cudaPeekAtLastError(), \"launch insertPoints\");\n1007\t    recordProfileEvent(2, stream);\n1008\t    checkCuda(cub::DeviceScan::ExclusiveSum(\n1009\t                  memory.scan_temporary, memory.scan_temporary_bytes,\n1010\t                  memory.grid_counts, memory.grid_offsets,\n1011\t                  grid_cell_capacity,\n1012\t                  stream),\n1013\t              \"prefix sum grid counts\");\n1014\t    recordProfileEvent(3, stream);\n1015\t    countingSort<<<blocksFor(database.size), kThreads, 0, stream>>>(\n1016\t        database.data, database_count, database.dimension, memory.point_cells,\n1017\t        memory.point_cell_indices, memory.grid_offsets,\n1018\t        memory.sorted_database, memory.sorted_database_indices);\n1019\t    checkCuda(cudaPeekAtLastError(), \"launch countingSort\");\n1020\t    recordProfileEvent(4, stream);\n1021\t\n1022\t    const float* search_query =\n1023\t        options.inputs_are_same ? memory.sorted_database : query.data;\n1024\t    const int* search_query_indices =\n1025\t        options.inputs_are_same ? memory.sorted_database_indices : nullptr;\n1026\t    launchGridNeighbors(\n1027\t        search_query, query_count, memory.sorted_database,\n1028\t        memory.sorted_database_indices, database_count, query.dimension,\n1029\t        memory.grid_parameters, memory.grid_offsets, radius, max_neighbors,\n1030\t        options.exclude_self, options.inputs_are_same,\n1031\t        search_query_indices, memory.neighbor_distances,\n1032\t        memory.neighbor_indices, stream);\n1033\t    checkCuda(cudaPeekAtLastError(), \"launch findNeighbors\");\n1034\t  }\n1035\t  recordProfileEvent(5, stream);\n1036\t  checkCuda(cudaMemsetAsync(memory.edge_counts, 0,\n1037\t                            (query.size + 1) * sizeof(std::int64_t), stream),\n1038\t            \"clear edge counts\");\n1039\t  countEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n1040\t      memory.neighbor_indices, query_count, max_neighbors, options.undirected,\n1041\t      memory.edge_counts);\n1042\t  checkCuda(cudaPeekAtLastError(), \"launch countEdges\");\n1043\t  recordProfileEvent(6, stream);\n1044\t  checkCuda(cub::DeviceScan::ExclusiveSum(\n1045\t                memory.scan_temporary, memory.scan_temporary_bytes,\n1046\t                memory.edge_counts, memory.edge_offsets, query_count + 1,\n1047\t                stream),\n1048\t            \"prefix sum edge counts\");\n1049\t  recordProfileEvent(7, stream);\n1050\t  if (!count_only) {\n1051\t    writeEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n1052\t        memory.neighbor_indices, query_count, max_neighbors,\n1053\t        options.undirected, memory.edge_offsets, output.edges);\n1054\t    checkCuda(cudaPeekAtLastError(), \"launch writeEdges\");\n1055\t  }\n1056\t  recordProfileEvent(8, stream);\n1057\t  checkCuda(cudaMemcpyAsync(\n1058\t                output.edge_count, memory.edge_offsets + query_count,\n1059\t                sizeof(std::int64_t), cudaMemcpyDeviceToDevice, stream),\n1060\t            \"copy edge count\");\n1061\t  recordProfileEvent(9, stream);\n1062\t}\n1063\t\n1064\t#if defined(FRNN_ENABLE_STAGE_PROFILING)\n1065\tnamespace detail {\n1066\t\n1067\tvoid profileBuildEdgesAsync(DevicePointView query, DevicePointView database,\n1068\t                            DeviceEdgeBuffer output, float radius,\n1069\t                            int max_neighbors, BuildOptions options,\n1070\t                            Workspace& workspace, cudaStream_t stream,\n1071\t                            float* stage_milliseconds, int stage_count) {\n1072\t  if (stage_milliseconds == nullptr ||\n1073\t      stage_count != kProfileEventCount - 1) {\n1074\t    throw std::invalid_argument(\"invalid stage profiling output\");\n1075\t  }\n1076\t  cudaEvent_t events[kProfileEventCount] = {};\n1077\t  for (cudaEvent_t& event : events) {\n1078\t    checkCuda(cudaEventCreate(&event), \"create profiling event\");\n1079\t  }\n1080\t  try {\n1081\t    active_profile_events = events;\n1082\t    buildEdgesAsync(query, database, output, radius, max_neighbors, options,\n1083\t                    workspace, stream);\n1084\t    active_profile_events = nullptr;\n1085\t    checkCuda(cudaEventSynchronize(events[kProfileEventCount - 1]),\n1086\t              \"synchronize profiling events\");\n1087\t    for (int stage = 0; stage < stage_count; ++stage) {\n1088\t      checkCuda(cudaEventElapsedTime(&stage_milliseconds[stage], events[stage],\n1089\t                                     events[stage + 1]),\n1090\t                \"calculate stage elapsed time\");\n1091\t    }\n1092\t  } catch (...) {\n1093\t    active_profile_events = nullptr;\n1094\t    for (cudaEvent_t event : events) {\n1095\t      if (event != nullptr) {\n1096\t        cudaEventDestroy(event);\n1097\t      }\n1098\t    }\n1099\t    throw;\n1100\t  }\n1101\t  for (cudaEvent_t event : events) {\n1102\t    cudaEventDestroy(event);\n1103\t  }\n1104\t}\n1105\t\n1106\t}  // namespace detail\n1107\t#endif\n1108\t\n1109\tstd::vector<Edge> buildEdges(PointView query, PointView database, float radius,\n1110\t                             int max_neighbors, BuildOptions options) {\n1111\t  validateHostValues(query, \"query\");\n1112\t  validateHostValues(database, \"database\");\n1113\t  if (query.dimension != database.dimension) {\n1114\t    throw std::invalid_argument(\n1115\t        \"query and database dimensions must be identical\");\n1116\t  }\n1117\t  validateConfiguration(radius, max_neighbors);\n1118\t  const std::int64_t capacity =\n1119\t      requiredEdgeCapacity(query.size, max_neighbors);\n1120\t  if (capacity == 0 || database.size == 0) {\n1121\t    return {};\n1122\t  }\n1123\t\n1124\t  float* device_query = nullptr;\n1125\t  float* device_database = nullptr;\n1126\t  std::int64_t* device_edges = nullptr;\n1127\t  std::int64_t* device_count = nullptr;\n1128\t  cudaStream_t stream = nullptr;\n1129\t  try {\n1130\t    checkCuda(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking),\n1131\t              \"create CUDA stream\");\n1132\t    allocateDevice(\n1133\t        &device_query,\n1134\t        static_cast<std::size_t>(query.size) * query.dimension,\n1135\t        \"allocate device query\");\n1136\t    const bool alias_inputs =\n1137\t        options.inputs_are_same && query.data == database.data &&\n1138\t        query.size == database.size;\n1139\t    if (alias_inputs) {\n1140\t      device_database = device_query;\n1141\t    } else {\n1142\t      allocateDevice(\n1143\t          &device_database,\n1144\t          static_cast<std::size_t>(database.size) * database.dimension,\n1145\t          \"allocate device database\");\n1146\t    }\n1147\t    allocateDevice(&device_count, 1, \"allocate device edge count\");\n1148\t\n1149\t    checkCuda(cudaMemcpyAsync(\n1150\t                  device_query, query.data,\n1151\t                  static_cast<std::size_t>(query.size) * query.dimension *\n1152\t                      sizeof(float),\n1153\t                  cudaMemcpyHostToDevice, stream),\n1154\t              \"copy query to device\");\n1155\t    if (!alias_inputs) {\n1156\t      checkCuda(cudaMemcpyAsync(\n1157\t                    device_database, database.data,\n1158\t                    static_cast<std::size_t>(database.size) *\n1159\t                        database.dimension * sizeof(float),\n1160\t                    cudaMemcpyHostToDevice, stream),\n1161\t                \"copy database to device\");\n1162\t    }\n1163\t\n1164\t    Workspace workspace;\n1165\t    workspace.reserve(query.size, database.size, query.dimension,\n1166\t                      max_neighbors, options.algorithm);\n1167\t    buildEdgesAsync(\n1168\t        {device_query, query.size, query.dimension},\n1169\t        {device_database, database.size, database.dimension},\n1170\t        {nullptr, 0, device_count}, radius, max_neighbors, options,\n1171\t        workspace, stream);\n1172\t\n1173\t    std::int64_t edge_count = 0;\n1174\t    checkCuda(cudaMemcpyAsync(&edge_count, device_count, sizeof(edge_count),\n1175\t                              cudaMemcpyDeviceToHost, stream),\n1176\t              \"copy edge count to host\");\n1177\t    checkCuda(cudaStreamSynchronize(stream), \"synchronize edge count\");\n1178\t    std::vector<Edge> result(static_cast<std::size_t>(edge_count));\n1179\t    if (edge_count > 0) {\n1180\t      allocateDevice(&device_edges,\n1181\t                     static_cast<std::size_t>(edge_count) * 2,\n1182\t                     \"allocate exact device edges\");\n1183\t      Workspace::Impl& memory = *workspace.impl_;\n1184\t      writeEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n1185\t          memory.neighbor_indices, static_cast<int>(query.size),\n1186\t          max_neighbors, options.undirected, memory.edge_offsets,\n1187\t          device_edges);\n1188\t      checkCuda(cudaPeekAtLastError(), \"launch writeEdges\");\n1189\t      checkCuda(cudaMemcpyAsync(\n1190\t                    result.data(), device_edges,\n1191\t                    static_cast<std::size_t>(edge_count) * sizeof(Edge),\n1192\t                    cudaMemcpyDeviceToHost, stream),\n1193\t                \"copy edges to host\");\n1194\t      checkCuda(cudaStreamSynchronize(stream), \"synchronize edge output\");\n1195\t    }\n1196\t\n1197\t    freeDevice(device_count);\n1198\t    freeDevice(device_edges);\n1199\t    if (!alias_inputs) {\n1200\t      freeDevice(device_database);\n1201\t    }\n1202\t    freeDevice(device_query);\n1203\t    checkCuda(cudaStreamDestroy(stream), \"destroy CUDA stream\");\n1204\t    return result;\n1205\t  } catch (...) {\n1206\t    freeDevice(device_count);\n1207\t    freeDevice(device_edges);\n1208\t    if (device_database != device_query) {\n1209\t      freeDevice(device_database);\n1210\t    }\n1211\t    freeDevice(device_query);\n1212\t    if (stream != nullptr) {\n1213\t      cudaStreamDestroy(stream);\n1214\t    }\n1215\t    throw;\n1216\t  }\n1217\t}\n1218\t\n1219\tstd::vector<Edge> buildEdges(PointView points, float radius,\n1220\t                             int max_neighbors) {\n1221\t  BuildOptions options;\n1222\t  options.exclude_self = true;\n1223\t  options.undirected = true;\n1224\t  options.inputs_are_same = true;\n1225\t  return buildEdges(points, points, radius, max_neighbors, options);\n1226\t}\n1227\t\n1228\tvoid buildEdges(std::vector<float>& query, std::vector<float>& database,\n1229\t                std::vector<std::int64_t>& edge_list,\n1230\t                std::int64_t num_spacepoints, int embedding_dim, float r_max,\n1231\t                int k_max) {\n1232\t  if (num_spacepoints < 0 || embedding_dim <= 0) {\n1233\t    throw std::invalid_argument(\n1234\t        \"num_spacepoints and embedding_dim must be valid\");\n1235\t  }\n1236\t  const std::size_t expected =\n1237\t      static_cast<std::size_t>(num_spacepoints) * embedding_dim;\n1238\t  if (query.size() != expected || database.size() != expected) {\n1239\t    throw std::invalid_argument(\n1240\t        \"query and database vector sizes do not match the declared shape\");\n1241\t  }\n1242\t  BuildOptions options;\n1243\t  options.exclude_self = true;\n1244\t  options.undirected = true;\n1245\t  options.inputs_are_same = true;\n1246\t  const std::vector<Edge> edges =\n1247\t      buildEdges({query.data(), num_spacepoints, embedding_dim},\n1248\t                 {database.data(), num_spacepoints, embedding_dim}, r_max,\n1249\t                 k_max, options);\n1250\t  edge_list.reserve(edge_list.size() + edges.size() * 2);\n1251\t  for (const Edge& edge : edges) {\n1252\t    edge_list.push_back(edge.source);\n1253\t  }\n1254\t  for (const Edge& edge : edges) {\n1255\t    edge_list.push_back(edge.target);\n1256\t  }\n1257\t}\n1258\t\n1259\tvoid buildEdges(std::vector<float>& points,\n1260\t                std::vector<std::int64_t>& edge_list,\n1261\t                std::int64_t num_spacepoints, int embedding_dim, float r_max,\n1262\t                int k_max) {\n1263\t  if (num_spacepoints < 0 || embedding_dim <= 0 ||\n1264\t      points.size() !=\n1265\t          static_cast<std::size_t>(num_spacepoints) * embedding_dim) {\n1266\t    throw std::invalid_argument(\n1267\t        \"points vector size does not match the declared shape\");\n1268\t  }\n1269\t  const std::vector<Edge> edges =\n1270\t      buildEdges({points.data(), num_spacepoints, embedding_dim}, r_max, k_max);\n1271\t  edge_list.reserve(edge_list.size() + edges.size() * 2);\n1272\t  for (const Edge& edge : edges) {\n1273\t    edge_list.push_back(edge.source);\n1274\t  }\n1275\t  for (const Edge& edge : edges) {\n1276\t    edge_list.push_back(edge.target);\n1277\t  }\n1278\t}\n1279\t\n1280\t}  // namespace frnn\n1281\t"}]},"parent_tool_use_id":null,"session_id":"6f82439e-67c9-4df8-8006-0f75deb44a8f","uuid":"3cd080c6-4ff5-407e-a50d-cf47f9979586","timestamp":"2026-09-20T23:12:27.833Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/libFRNN/src/frnn.cu","content":"#include <frnn/frnn.hpp>\n\n#include <cub/device/device_scan.cuh>\n#include <cuda_runtime.h>\n\n#include <algorithm>\n#include <cmath>\n#include <cstdint>\n#include <limits>\n#include <sstream>\n#include <stdexcept>\n#include <utility>\n\nnamespace frnn {\nnamespace {\n\n#if defined(FRNN_ENABLE_STAGE_PROFILING)\nconstexpr int kProfileEventCount = 10;\nthread_local cudaEvent_t* active_profile_events = nullptr;\n#endif\n\nconstexpr int kGridDimensions = 4;\nconstexpr int kMaximumGridResolution = 128;\nconstexpr int kMaximumGridCells3D = 128 * 1024;\nconstexpr int kMaximumGridCells4D = 128 * 128 * 128;\nconstexpr int kThreads = 256;\nconstexpr std::int64_t kBruteForceCoordinateWork = 2'000'000;\n\nstruct GridParameters {\n  float minimum[kGridDimensions];\n  float inverse_cell_size;\n  int resolution[kGridDimensions];\n  int total_cells;\n  int grid_dimensions;\n};\n\n[[noreturn]] void throwCuda(cudaError_t error, const char* operation) {\n  std::ostringstream message;\n  message << operation << \": \" << cudaGetErrorString(error);\n  throw std::runtime_error(message.str());\n}\n\nvoid checkCuda(cudaError_t error, const char* operation) {\n  if (error != cudaSuccess) {\n    throwCuda(error, operation);\n  }\n}\n\n#if defined(FRNN_ENABLE_STAGE_PROFILING)\nvoid recordProfileEvent(int index, cudaStream_t stream) {\n  if (active_profile_events != nullptr) {\n    checkCuda(cudaEventRecord(active_profile_events[index], stream),\n              \"record profiling event\");\n  }\n}\n#else\nvoid recordProfileEvent(int, cudaStream_t) {}\n#endif\n\nint blocksFor(std::int64_t count) {\n  if (count <= 0) {\n    return 1;\n  }\n  return static_cast<int>(\n      std::min<std::int64_t>((count + kThreads - 1) / kThreads, 65535));\n}\n\nint gridDimensionCount(int dimension) {\n  return dimension <= 4 ? std::min(dimension, 3) : kGridDimensions;\n}\n\nint maximumGridCells(int dimension) {\n  return gridDimensionCount(dimension) <= 3 ? kMaximumGridCells3D\n                                            : kMaximumGridCells4D;\n}\n\nvoid validateView(std::int64_t size, int dimension, const float* data,\n                  const char* name) {\n  if (size < 0) {\n    throw std::invalid_argument(std::string(name) + \".size must be non-negative\");\n  }\n  if (dimension <= 0) {\n    throw std::invalid_argument(std::string(name) +\n                                \".dimension must be positive\");\n  }\n  if (dimension > 32) {\n    throw std::invalid_argument(std::string(name) +\n                                \".dimension must not exceed 32\");\n  }\n  if (size > 0 && data == nullptr) {\n    throw std::invalid_argument(std::string(name) +\n                                \".data must not be null for non-empty input\");\n  }\n  if (size > std::numeric_limits<int>::max()) {\n    throw std::invalid_argument(std::string(name) +\n                                \".size exceeds the supported CUDA index range\");\n  }\n}\n\nvoid validateConfiguration(float radius, int max_neighbors) {\n  if (!std::isfinite(radius) || radius <= 0.0F) {\n    throw std::invalid_argument(\"radius must be finite and greater than zero\");\n  }\n  if (max_neighbors < 0) {\n    throw std::invalid_argument(\"max_neighbors must be non-negative\");\n  }\n}\n\nvoid validateHostValues(PointView view, const char* name) {\n  validateView(view.size, view.dimension, view.data, name);\n  const std::int64_t values = view.size * view.dimension;\n  for (std::int64_t index = 0; index < values; ++index) {\n    if (!std::isfinite(view.data[index])) {\n      throw std::invalid_argument(std::string(name) +\n                                  \" contains a non-finite coordinate\");\n    }\n  }\n}\n\n__device__ float atomicMinimum(float* address, float value) {\n  int* integer_address = reinterpret_cast<int*>(address);\n  int old = *integer_address;\n  while (value < __int_as_float(old)) {\n    const int assumed = old;\n    old = atomicCAS(integer_address, assumed, __float_as_int(value));\n    if (old == assumed) {\n      break;\n    }\n  }\n  return __int_as_float(old);\n}\n\n__device__ float atomicMaximum(float* address, float value) {\n  int* integer_address = reinterpret_cast<int*>(address);\n  int old = *integer_address;\n  while (value > __int_as_float(old)) {\n    const int assumed = old;\n    old = atomicCAS(integer_address, assumed, __float_as_int(value));\n    if (old == assumed) {\n      break;\n    }\n  }\n  return __int_as_float(old);\n}\n\n__global__ void initializeBounds(float* bounds) {\n  if (threadIdx.x < kGridDimensions) {\n    bounds[threadIdx.x] = INFINITY;\n    bounds[kGridDimensions + threadIdx.x] = -INFINITY;\n  }\n}\n\n__global__ void computeBounds(const float* points, int point_count,\n                              int dimension, int grid_dimensions,\n                              float* bounds) {\n  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n       point < point_count; point += blockDim.x * gridDim.x) {\n    for (int axis = 0; axis < grid_dimensions; ++axis) {\n      const float value = points[point * dimension + axis];\n      atomicMinimum(&bounds[axis], value);\n      atomicMaximum(&bounds[kGridDimensions + axis], value);\n    }\n  }\n}\n\n__global__ void finalizeGrid(const float* bounds, int grid_dimensions,\n                             int maximum_cells, float radius,\n                             GridParameters* parameters) {\n  if (blockIdx.x != 0 || threadIdx.x != 0) {\n    return;\n  }\n\n  float largest_extent = 0.0F;\n  for (int axis = 0; axis < grid_dimensions; ++axis) {\n    largest_extent =\n        fmaxf(largest_extent,\n              bounds[kGridDimensions + axis] - bounds[axis]);\n  }\n  const float radius_cell_size =\n      radius * (grid_dimensions <= 3 ? 1.0F : 0.5F);\n  float cell_size = fmaxf(radius_cell_size,\n                          largest_extent /\n                              static_cast<float>(kMaximumGridResolution - 1));\n  if (!(cell_size > 0.0F) || !isfinite(cell_size)) {\n    cell_size = radius_cell_size;\n  }\n\n  int resolution[kGridDimensions] = {1, 1, 1, 1};\n  int total_cells = 1;\n  for (int attempt = 0; attempt < 8; ++attempt) {\n    long long candidate_cells = 1;\n    for (int axis = 0; axis < grid_dimensions; ++axis) {\n      int axis_resolution = static_cast<int>(\n                                floorf((bounds[kGridDimensions + axis] -\n                                        bounds[axis]) /\n                                       cell_size)) +\n                            1;\n      axis_resolution =\n          max(1, min(kMaximumGridResolution, axis_resolution));\n      resolution[axis] = axis_resolution;\n      candidate_cells *= axis_resolution;\n    }\n    if (candidate_cells <= maximum_cells) {\n      total_cells = static_cast<int>(candidate_cells);\n      break;\n    }\n    const float scale =\n        powf(static_cast<float>(candidate_cells) /\n                 static_cast<float>(maximum_cells),\n             1.0F / static_cast<float>(grid_dimensions));\n    cell_size *= fmaxf(1.01F, scale * 1.01F);\n  }\n\n  parameters->inverse_cell_size = 1.0F / cell_size;\n  parameters->grid_dimensions = grid_dimensions;\n  parameters->total_cells = total_cells;\n  for (int axis = 0; axis < kGridDimensions; ++axis) {\n    if (axis < grid_dimensions) {\n      parameters->minimum[axis] = bounds[axis];\n      parameters->resolution[axis] = resolution[axis];\n    } else {\n      parameters->minimum[axis] = 0.0F;\n      parameters->resolution[axis] = 1;\n    }\n  }\n}\n\n__global__ void insertPoints(const float* points, int point_count,\n                             int dimension,\n                             const GridParameters* parameters,\n                             int* grid_counts, int* point_cells,\n                             int* point_cell_indices) {\n  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n       point < point_count; point += blockDim.x * gridDim.x) {\n    int coordinate[kGridDimensions] = {0, 0, 0, 0};\n    for (int axis = 0; axis < parameters->grid_dimensions; ++axis) {\n      coordinate[axis] = static_cast<int>(\n          floorf((points[point * dimension + axis] -\n                  parameters->minimum[axis]) *\n                 parameters->inverse_cell_size));\n      coordinate[axis] =\n          max(0, min(parameters->resolution[axis] - 1, coordinate[axis]));\n    }\n    const int cell =\n        ((coordinate[0] * parameters->resolution[1] + coordinate[1]) *\n                 parameters->resolution[2] +\n             coordinate[2]) *\n            parameters->resolution[3] +\n        coordinate[3];\n    point_cells[point] = cell;\n    point_cell_indices[point] = atomicAdd(&grid_counts[cell], 1);\n  }\n}\n\n__global__ void countingSort(const float* points, int point_count,\n                             int dimension, const int* point_cells,\n                             const int* point_cell_indices,\n                             const int* grid_offsets, float* sorted_points,\n                             int* sorted_indices) {\n  for (int point = blockIdx.x * blockDim.x + threadIdx.x;\n       point < point_count; point += blockDim.x * gridDim.x) {\n    const int destination =\n        grid_offsets[point_cells[point]] + point_cell_indices[point];\n    for (int axis = 0; axis < dimension; ++axis) {\n      sorted_points[destination * dimension + axis] =\n          points[point * dimension + axis];\n    }\n    sorted_indices[destination] = point;\n  }\n}\n\n__device__ bool precedes(float lhs_distance, std::int64_t lhs_index,\n                         float rhs_distance, std::int64_t rhs_index) {\n  return lhs_distance < rhs_distance ||\n         (lhs_distance == rhs_distance && lhs_index < rhs_index);\n}\n\n__device__ void insertNeighbor(float distance, int database_index,\n                               int max_neighbors, int& found,\n                               float* distances, int* indices) {\n  int insertion = min(found, max_neighbors);\n  while (insertion > 0 &&\n         precedes(distance, database_index, distances[insertion - 1],\n                  indices[insertion - 1])) {\n    --insertion;\n  }\n  if (insertion >= max_neighbors) {\n    return;\n  }\n  const int last = min(found, max_neighbors - 1);\n  for (int position = last; position > insertion; --position) {\n    distances[position] = distances[position - 1];\n    indices[position] = indices[position - 1];\n  }\n  distances[insertion] = distance;\n  indices[insertion] = database_index;\n  found = min(found + 1, max_neighbors);\n}\n\n__device__ bool follows(float lhs_distance, int lhs_index,\n                        float rhs_distance, int rhs_index) {\n  return precedes(rhs_distance, rhs_index, lhs_distance, lhs_index);\n}\n\n__device__ void swapNeighbor(float* distances, int* indices, int lhs,\n                             int rhs) {\n  const float distance = distances[lhs];\n  const int index = indices[lhs];\n  distances[lhs] = distances[rhs];\n  indices[lhs] = indices[rhs];\n  distances[rhs] = distance;\n  indices[rhs] = index;\n}\n\n__device__ void siftNeighborDown(float* distances, int* indices, int count,\n                                 int root) {\n  while (true) {\n    const int left = root * 2 + 1;\n    if (left >= count) {\n      return;\n    }\n    int worst = left;\n    const int right = left + 1;\n    if (right < count &&\n        follows(distances[right], indices[right], distances[left],\n                indices[left])) {\n      worst = right;\n    }\n    if (!follows(distances[worst], indices[worst], distances[root],\n                 indices[root])) {\n      return;\n    }\n    swapNeighbor(distances, indices, root, worst);\n    root = worst;\n  }\n}\n\n__device__ void insertNeighborHeap(float distance, int database_index,\n                                   int max_neighbors, int& found,\n                                   float* distances, int* indices) {\n  if (found < max_neighbors) {\n    int position = found++;\n    distances[position] = distance;\n    indices[position] = database_index;\n    while (position > 0) {\n      const int parent = (position - 1) / 2;\n      if (!follows(distances[position], indices[position],\n                   distances[parent], indices[parent])) {\n        break;\n      }\n      swapNeighbor(distances, indices, position, parent);\n      position = parent;\n    }\n    return;\n  }\n  if (!precedes(distance, database_index, distances[0], indices[0])) {\n    return;\n  }\n  distances[0] = distance;\n  indices[0] = database_index;\n  siftNeighborDown(distances, indices, found, 0);\n}\n\n__device__ void sortNeighborHeap(float* distances, int* indices, int count) {\n  for (int end = count - 1; end > 0; --end) {\n    swapNeighbor(distances, indices, 0, end);\n    siftNeighborDown(distances, indices, end, 0);\n  }\n}\n\n__device__ void buildNeighborHeap(float* distances, int* indices, int count) {\n  for (int root = count / 2 - 1; root >= 0; --root) {\n    siftNeighborDown(distances, indices, count, root);\n  }\n}\n\n__device__ void selectNeighbor(float distance, int database_index,\n                               int max_neighbors, int& found, bool& heap_mode,\n                               float* distances, int* indices) {\n  if (max_neighbors >= 64 && (heap_mode || found >= 24)) {\n    if (!heap_mode) {\n      buildNeighborHeap(distances, indices, found);\n      heap_mode = true;\n    }\n    insertNeighborHeap(distance, database_index, max_neighbors, found,\n                       distances, indices);\n  } else {\n    insertNeighbor(distance, database_index, max_neighbors, found, distances,\n                   indices);\n  }\n}\n\ntemplate <int StaticDimension>\n__device__ float squaredDistance(const float* lhs, const float* rhs,\n                                 int runtime_dimension, float limit) {\n  const int dimension =\n      StaticDimension == 0 ? runtime_dimension : StaticDimension;\n  float distance = 0.0F;\n#pragma unroll\n  for (int axis = 0; axis < dimension; ++axis) {\n    const float difference = lhs[axis] - rhs[axis];\n    distance += difference * difference;\n    if (distance > limit) {\n      break;\n    }\n  }\n  return distance;\n}\n\ntemplate <int StaticDimension>\n__global__ void findNeighborsBruteForce(\n    const float* query, int query_count, const float* database,\n    int database_count, int dimension, float radius, int max_neighbors,\n    bool exclude_self, bool inputs_are_same, float* neighbor_distances,\n    int* neighbor_indices) {\n  const float radius_squared = radius * radius;\n  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n       query_index < query_count;\n       query_index += blockDim.x * gridDim.x) {\n    const float* query_point = query + query_index * dimension;\n    float cached_query[StaticDimension == 0 ? 1 : StaticDimension];\n    if constexpr (StaticDimension != 0) {\n#pragma unroll\n      for (int axis = 0; axis < StaticDimension; ++axis) {\n        cached_query[axis] = query_point[axis];\n      }\n      query_point = cached_query;\n    }\n    float* distances =\n        neighbor_distances + static_cast<std::int64_t>(query_index) *\n                                 max_neighbors;\n    int* indices =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    int found = 0;\n    bool heap_mode = false;\n\n    for (int database_index = 0; database_index < database_count;\n         ++database_index) {\n      if (exclude_self && inputs_are_same &&\n          database_index == query_index) {\n        continue;\n      }\n      const float distance = squaredDistance<StaticDimension>(\n          database + database_index * dimension,\n          query_point, dimension, radius_squared);\n      if (distance <= radius_squared) {\n        selectNeighbor(distance, database_index, max_neighbors, found,\n                       heap_mode, distances, indices);\n      }\n    }\n    if (heap_mode) {\n      sortNeighborHeap(distances, indices, found);\n    }\n    if (found < max_neighbors) {\n      indices[found] = -1;\n    }\n  }\n}\n\ntemplate <int StaticDimension>\n__global__ void findNeighbors(\n    const float* query, int query_count, const float* sorted_database,\n    const int* sorted_database_indices, int database_count, int dimension,\n    const GridParameters* parameters, const int* grid_offsets, float radius,\n    int max_neighbors, bool exclude_self, bool inputs_are_same,\n    const int* query_indices, float* neighbor_distances,\n    int* neighbor_indices) {\n  const float radius_squared = radius * radius;\n  for (int work_index = blockIdx.x * blockDim.x + threadIdx.x;\n       work_index < query_count;\n       work_index += blockDim.x * gridDim.x) {\n    const int query_index =\n        query_indices == nullptr ? work_index : query_indices[work_index];\n    const float* query_point = query + work_index * dimension;\n    float cached_query[StaticDimension == 0 ? 1 : StaticDimension];\n    if constexpr (StaticDimension != 0) {\n#pragma unroll\n      for (int axis = 0; axis < StaticDimension; ++axis) {\n        cached_query[axis] = query_point[axis];\n      }\n      query_point = cached_query;\n    }\n    float* distances =\n        neighbor_distances + static_cast<std::int64_t>(query_index) *\n                                 max_neighbors;\n    int* indices =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    int found = 0;\n    bool heap_mode = false;\n\n    int minimum_cell[kGridDimensions] = {0, 0, 0, 0};\n    int maximum_cell[kGridDimensions] = {0, 0, 0, 0};\n    for (int axis = 0; axis < parameters->grid_dimensions; ++axis) {\n      const float coordinate = query_point[axis];\n      minimum_cell[axis] = max(\n          0, static_cast<int>(floorf(\n                 (coordinate - parameters->minimum[axis] - radius) *\n                 parameters->inverse_cell_size)));\n      maximum_cell[axis] =\n          min(parameters->resolution[axis] - 1,\n              static_cast<int>(floorf(\n                  (coordinate - parameters->minimum[axis] + radius) *\n                  parameters->inverse_cell_size)));\n    }\n\n    for (int x = minimum_cell[0]; x <= maximum_cell[0]; ++x) {\n      for (int y = minimum_cell[1]; y <= maximum_cell[1]; ++y) {\n        for (int z = minimum_cell[2]; z <= maximum_cell[2]; ++z) {\n          for (int w = minimum_cell[3]; w <= maximum_cell[3]; ++w) {\n            const int cell =\n                ((x * parameters->resolution[1] + y) *\n                         parameters->resolution[2] +\n                     z) *\n                    parameters->resolution[3] +\n                w;\n            const int begin = grid_offsets[cell];\n            const int end =\n                cell + 1 < parameters->total_cells\n                    ? grid_offsets[cell + 1]\n                    : database_count;\n            for (int sorted_index = begin; sorted_index < end;\n                 ++sorted_index) {\n              const int database_index =\n                  sorted_database_indices[sorted_index];\n              if (exclude_self && inputs_are_same &&\n                  database_index == query_index) {\n                continue;\n              }\n\n              const float distance = squaredDistance<StaticDimension>(\n                  sorted_database + sorted_index * dimension,\n                  query_point, dimension, radius_squared);\n              if (distance > radius_squared) {\n                continue;\n              }\n\n              selectNeighbor(distance, database_index, max_neighbors, found,\n                             heap_mode, distances, indices);\n            }\n          }\n        }\n      }\n    }\n    if (heap_mode) {\n      sortNeighborHeap(distances, indices, found);\n    }\n    if (found < max_neighbors) {\n      indices[found] = -1;\n    }\n  }\n}\n\nvoid launchBruteForceNeighbors(\n    const float* query, int query_count, const float* database,\n    int database_count, int dimension, float radius, int max_neighbors,\n    bool exclude_self, bool inputs_are_same, float* neighbor_distances,\n    int* neighbor_indices, cudaStream_t stream) {\n  const int blocks = blocksFor(query_count);\n#define FRNN_LAUNCH_BRUTE_FORCE(Dimension)                                  \\\n  findNeighborsBruteForce<Dimension>                                       \\\n      <<<blocks, kThreads, 0, stream>>>(                                   \\\n          query, query_count, database, database_count, dimension, radius, \\\n          max_neighbors, exclude_self, inputs_are_same,                    \\\n          neighbor_distances, neighbor_indices)\n  switch (dimension) {\n    case 1:\n      FRNN_LAUNCH_BRUTE_FORCE(1);\n      break;\n    case 2:\n      FRNN_LAUNCH_BRUTE_FORCE(2);\n      break;\n    case 3:\n      FRNN_LAUNCH_BRUTE_FORCE(3);\n      break;\n    case 4:\n      FRNN_LAUNCH_BRUTE_FORCE(4);\n      break;\n    case 8:\n      FRNN_LAUNCH_BRUTE_FORCE(8);\n      break;\n    case 12:\n      FRNN_LAUNCH_BRUTE_FORCE(12);\n      break;\n    case 16:\n      FRNN_LAUNCH_BRUTE_FORCE(16);\n      break;\n    default:\n      FRNN_LAUNCH_BRUTE_FORCE(0);\n      break;\n  }\n#undef FRNN_LAUNCH_BRUTE_FORCE\n}\n\nvoid launchGridNeighbors(\n    const float* query, int query_count, const float* sorted_database,\n    const int* sorted_database_indices, int database_count, int dimension,\n    const GridParameters* parameters, const int* grid_offsets, float radius,\n    int max_neighbors, bool exclude_self, bool inputs_are_same,\n    const int* query_indices, float* neighbor_distances,\n    int* neighbor_indices, cudaStream_t stream) {\n  const int blocks = blocksFor(query_count);\n#define FRNN_LAUNCH_GRID(Dimension)                                        \\\n  findNeighbors<Dimension><<<blocks, kThreads, 0, stream>>>(               \\\n      query, query_count, sorted_database, sorted_database_indices,        \\\n      database_count, dimension, parameters, grid_offsets, radius,         \\\n      max_neighbors, exclude_self, inputs_are_same, query_indices,         \\\n      neighbor_distances, neighbor_indices)\n  switch (dimension) {\n    case 1:\n      FRNN_LAUNCH_GRID(1);\n      break;\n    case 2:\n      FRNN_LAUNCH_GRID(2);\n      break;\n    case 3:\n      FRNN_LAUNCH_GRID(3);\n      break;\n    case 4:\n      FRNN_LAUNCH_GRID(4);\n      break;\n    case 8:\n      FRNN_LAUNCH_GRID(8);\n      break;\n    case 12:\n      FRNN_LAUNCH_GRID(12);\n      break;\n    case 16:\n      FRNN_LAUNCH_GRID(16);\n      break;\n    default:\n      FRNN_LAUNCH_GRID(0);\n      break;\n  }\n#undef FRNN_LAUNCH_GRID\n}\n\n__global__ void countEdges(const int* neighbor_indices,\n                           int query_count, int max_neighbors,\n                           bool undirected, std::int64_t* edge_counts) {\n  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n       query_index < query_count;\n       query_index += blockDim.x * gridDim.x) {\n    std::int64_t count = 0;\n    const int* neighbors =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n      const int target = neighbors[neighbor];\n      if (target < 0) {\n        break;\n      }\n      if (!undirected || query_index > target) {\n        ++count;\n      }\n    }\n    edge_counts[query_index] = count;\n  }\n}\n\n__global__ void writeEdges(const int* neighbor_indices,\n                           int query_count, int max_neighbors,\n                           bool undirected,\n                           const std::int64_t* edge_offsets,\n                           std::int64_t* edges) {\n  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n       query_index < query_count;\n       query_index += blockDim.x * gridDim.x) {\n    std::int64_t output_index = edge_offsets[query_index];\n    const int* neighbors =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n      const int target = neighbors[neighbor];\n      if (target < 0) {\n        break;\n      }\n      if (!undirected || query_index > target) {\n        edges[output_index * 2] = query_index;\n        edges[output_index * 2 + 1] = target;\n        ++output_index;\n      }\n    }\n  }\n}\n\ntemplate <typename T>\nvoid allocateDevice(T** pointer, std::size_t count, const char* name) {\n  if (count == 0) {\n    *pointer = nullptr;\n    return;\n  }\n  checkCuda(cudaMalloc(reinterpret_cast<void**>(pointer), count * sizeof(T)),\n            name);\n}\n\ntemplate <typename T>\nvoid freeDevice(T*& pointer) noexcept {\n  if (pointer != nullptr) {\n    cudaFree(pointer);\n    pointer = nullptr;\n  }\n}\n\nSearchAlgorithm resolveAlgorithm(SearchAlgorithm requested,\n                                 std::int64_t query_count,\n                                 std::int64_t database_count, int dimension,\n                                 int max_neighbors) {\n  if (requested != SearchAlgorithm::automatic) {\n    return requested;\n  }\n  if (query_count == 0 || database_count == 0) {\n    return SearchAlgorithm::brute_force;\n  }\n  const std::int64_t database_dimensions =\n      database_count > kBruteForceCoordinateWork / dimension\n          ? kBruteForceCoordinateWork + 1\n          : database_count * dimension;\n  const std::int64_t selection_factor =\n      std::max<std::int64_t>(1, (max_neighbors + 7) / 8);\n  if (database_dimensions > kBruteForceCoordinateWork / selection_factor) {\n    return SearchAlgorithm::grid;\n  }\n  const std::int64_t work_per_query =\n      database_dimensions * selection_factor;\n  const bool fits =\n      query_count <= kBruteForceCoordinateWork / work_per_query;\n  return fits ? SearchAlgorithm::brute_force : SearchAlgorithm::grid;\n}\n\n}  // namespace\n\nstruct Workspace::Impl {\n  int device = -1;\n  std::int64_t query_capacity = 0;\n  std::int64_t database_capacity = 0;\n  int dimension_capacity = 0;\n  int neighbor_capacity = 0;\n  bool has_grid_storage = false;\n  int grid_cell_capacity = 0;\n\n  float* bounds = nullptr;\n  GridParameters* grid_parameters = nullptr;\n  int* grid_counts = nullptr;\n  int* grid_offsets = nullptr;\n  int* point_cells = nullptr;\n  int* point_cell_indices = nullptr;\n  float* sorted_database = nullptr;\n  int* sorted_database_indices = nullptr;\n  float* neighbor_distances = nullptr;\n  int* neighbor_indices = nullptr;\n  std::int64_t* edge_counts = nullptr;\n  std::int64_t* edge_offsets = nullptr;\n  void* scan_temporary = nullptr;\n  std::size_t scan_temporary_bytes = 0;\n};\n\nWorkspace::Workspace() : impl_(std::make_unique<Impl>()) {}\nWorkspace::~Workspace() { clear(); }\nWorkspace::Workspace(Workspace&&) noexcept = default;\nWorkspace& Workspace::operator=(Workspace&& other) noexcept {\n  if (this != &other) {\n    clear();\n    impl_ = std::move(other.impl_);\n  }\n  return *this;\n}\n\nvoid Workspace::clear() noexcept {\n  if (!impl_) {\n    return;\n  }\n  int original_device = -1;\n  cudaGetDevice(&original_device);\n  if (impl_->device >= 0 && impl_->device != original_device) {\n    cudaSetDevice(impl_->device);\n  }\n  freeDevice(impl_->bounds);\n  freeDevice(impl_->grid_parameters);\n  freeDevice(impl_->grid_counts);\n  freeDevice(impl_->grid_offsets);\n  freeDevice(impl_->point_cells);\n  freeDevice(impl_->point_cell_indices);\n  freeDevice(impl_->sorted_database);\n  freeDevice(impl_->sorted_database_indices);\n  freeDevice(impl_->neighbor_distances);\n  freeDevice(impl_->neighbor_indices);\n  freeDevice(impl_->edge_counts);\n  freeDevice(impl_->edge_offsets);\n  if (impl_->scan_temporary != nullptr) {\n    cudaFree(impl_->scan_temporary);\n    impl_->scan_temporary = nullptr;\n  }\n  if (impl_->device >= 0 && impl_->device != original_device &&\n      original_device >= 0) {\n    cudaSetDevice(original_device);\n  }\n  *impl_ = Impl{};\n}\n\nvoid Workspace::reserve(std::int64_t max_query_points,\n                        std::int64_t max_database_points, int dimension,\n                        int max_neighbors, SearchAlgorithm algorithm) {\n  validateView(max_query_points, dimension,\n               max_query_points == 0 ? nullptr\n                                     : reinterpret_cast<const float*>(1),\n               \"max_query_points\");\n  validateView(max_database_points, dimension,\n               max_database_points == 0 ? nullptr\n                                        : reinterpret_cast<const float*>(1),\n               \"max_database_points\");\n  if (max_neighbors < 0) {\n    throw std::invalid_argument(\"max_neighbors must be non-negative\");\n  }\n  requiredEdgeCapacity(max_query_points, max_neighbors);\n  const SearchAlgorithm resolved_algorithm =\n      resolveAlgorithm(algorithm, max_query_points, max_database_points,\n                       dimension, max_neighbors);\n  const bool needs_grid_storage =\n      resolved_algorithm == SearchAlgorithm::grid;\n  const int required_grid_cells =\n      needs_grid_storage ? maximumGridCells(dimension) : 0;\n\n  int current_device = -1;\n  checkCuda(cudaGetDevice(&current_device), \"cudaGetDevice\");\n  if (impl_->device == current_device &&\n      impl_->query_capacity >= max_query_points &&\n      impl_->database_capacity >= max_database_points &&\n      impl_->dimension_capacity >= dimension &&\n      impl_->neighbor_capacity >= max_neighbors &&\n      (!needs_grid_storage ||\n       (impl_->has_grid_storage &&\n        impl_->grid_cell_capacity >= required_grid_cells))) {\n    return;\n  }\n\n  const std::int64_t query_capacity =\n      std::max(impl_->query_capacity, max_query_points);\n  const std::int64_t database_capacity =\n      std::max(impl_->database_capacity, max_database_points);\n  const int dimension_capacity =\n      std::max(impl_->dimension_capacity, dimension);\n  const int neighbor_capacity =\n      std::max(impl_->neighbor_capacity, max_neighbors);\n  clear();\n  impl_->device = current_device;\n  impl_->query_capacity = query_capacity;\n  impl_->database_capacity = database_capacity;\n  impl_->dimension_capacity = dimension_capacity;\n  impl_->neighbor_capacity = neighbor_capacity;\n  impl_->has_grid_storage = needs_grid_storage;\n  impl_->grid_cell_capacity = required_grid_cells;\n\n  try {\n    if (needs_grid_storage) {\n      allocateDevice(&impl_->bounds, 2 * kGridDimensions, \"allocate bounds\");\n      allocateDevice(&impl_->grid_parameters, 1, \"allocate grid parameters\");\n      allocateDevice(&impl_->grid_counts, required_grid_cells,\n                     \"allocate grid counts\");\n      allocateDevice(&impl_->grid_offsets, required_grid_cells,\n                     \"allocate grid offsets\");\n      allocateDevice(&impl_->point_cells,\n                     static_cast<std::size_t>(database_capacity),\n                     \"allocate point cells\");\n      allocateDevice(&impl_->point_cell_indices,\n                     static_cast<std::size_t>(database_capacity),\n                     \"allocate point cell indices\");\n      allocateDevice(\n          &impl_->sorted_database,\n          static_cast<std::size_t>(database_capacity) * dimension_capacity,\n          \"allocate sorted database\");\n      allocateDevice(&impl_->sorted_database_indices,\n                     static_cast<std::size_t>(database_capacity),\n                     \"allocate sorted database indices\");\n    }\n    const std::size_t neighbor_values =\n        static_cast<std::size_t>(query_capacity) * neighbor_capacity;\n    allocateDevice(&impl_->neighbor_distances, neighbor_values,\n                   \"allocate neighbor distances\");\n    allocateDevice(&impl_->neighbor_indices, neighbor_values,\n                   \"allocate neighbor indices\");\n    allocateDevice(&impl_->edge_counts,\n                   static_cast<std::size_t>(query_capacity) + 1,\n                   \"allocate edge counts\");\n    allocateDevice(&impl_->edge_offsets,\n                   static_cast<std::size_t>(query_capacity) + 1,\n                   \"allocate edge offsets\");\n\n    std::size_t grid_scan_bytes = 0;\n    if (needs_grid_storage) {\n      checkCuda(cub::DeviceScan::ExclusiveSum(\n                    nullptr, grid_scan_bytes, impl_->grid_counts,\n                    impl_->grid_offsets, required_grid_cells),\n                \"size grid prefix-sum workspace\");\n    }\n    std::size_t edge_scan_bytes = 0;\n    checkCuda(cub::DeviceScan::ExclusiveSum(\n                  nullptr, edge_scan_bytes, impl_->edge_counts,\n                  impl_->edge_offsets,\n                  static_cast<int>(query_capacity + 1)),\n              \"size edge prefix-sum workspace\");\n    impl_->scan_temporary_bytes =\n        std::max(grid_scan_bytes, edge_scan_bytes);\n    checkCuda(cudaMalloc(&impl_->scan_temporary,\n                         impl_->scan_temporary_bytes),\n              \"allocate prefix-sum workspace\");\n  } catch (...) {\n    clear();\n    throw;\n  }\n}\n\nstd::int64_t requiredEdgeCapacity(std::int64_t query_points,\n                                  int max_neighbors) {\n  if (query_points < 0 || max_neighbors < 0) {\n    throw std::invalid_argument(\n        \"query_points and max_neighbors must be non-negative\");\n  }\n  if (max_neighbors != 0 &&\n      query_points >\n          std::numeric_limits<std::int64_t>::max() / max_neighbors) {\n    throw std::overflow_error(\"edge capacity exceeds int64 range\");\n  }\n  return query_points * max_neighbors;\n}\n\nvoid buildEdgesAsync(DevicePointView query, DevicePointView database,\n                     DeviceEdgeBuffer output, float radius, int max_neighbors,\n                     BuildOptions options, Workspace& workspace,\n                     cudaStream_t stream) {\n  validateView(query.size, query.dimension, query.data, \"query\");\n  validateView(database.size, database.dimension, database.data, \"database\");\n  if (query.dimension != database.dimension) {\n    throw std::invalid_argument(\n        \"query and database dimensions must be identical\");\n  }\n  validateConfiguration(radius, max_neighbors);\n  const std::int64_t required_capacity =\n      requiredEdgeCapacity(query.size, max_neighbors);\n  if (output.edge_count == nullptr) {\n    throw std::invalid_argument(\"output.edge_count must not be null\");\n  }\n  const bool count_only = output.edges == nullptr;\n  if (!count_only && output.capacity < required_capacity) {\n    throw std::invalid_argument(\n        \"output.capacity is smaller than requiredEdgeCapacity\");\n  }\n  if (options.undirected && !options.inputs_are_same) {\n    throw std::invalid_argument(\n        \"undirected output requires inputs_are_same=true\");\n  }\n  if (options.inputs_are_same && query.size != database.size) {\n    throw std::invalid_argument(\n        \"inputs_are_same requires equal query and database sizes\");\n  }\n\n  if (query.size == 0 || database.size == 0 || max_neighbors == 0) {\n    checkCuda(cudaMemsetAsync(output.edge_count, 0, sizeof(std::int64_t),\n                              stream),\n              \"clear edge count\");\n    return;\n  }\n\n  const SearchAlgorithm algorithm =\n      resolveAlgorithm(options.algorithm, query.size, database.size,\n                       query.dimension, max_neighbors);\n  workspace.reserve(query.size, database.size, query.dimension,\n                    max_neighbors, algorithm);\n  Workspace::Impl& memory = *workspace.impl_;\n  const int query_count = static_cast<int>(query.size);\n  const int database_count = static_cast<int>(database.size);\n  const int grid_cell_capacity = maximumGridCells(query.dimension);\n  recordProfileEvent(0, stream);\n  if (algorithm == SearchAlgorithm::brute_force) {\n    for (int event = 1; event <= 4; ++event) {\n      recordProfileEvent(event, stream);\n    }\n    launchBruteForceNeighbors(\n        query.data, query_count, database.data, database_count,\n        query.dimension, radius, max_neighbors, options.exclude_self,\n        options.inputs_are_same, memory.neighbor_distances,\n        memory.neighbor_indices, stream);\n    checkCuda(cudaPeekAtLastError(), \"launch findNeighborsBruteForce\");\n  } else {\n    const int grid_dimensions = gridDimensionCount(query.dimension);\n    initializeBounds<<<1, kGridDimensions, 0, stream>>>(memory.bounds);\n    checkCuda(cudaPeekAtLastError(), \"launch initializeBounds\");\n    computeBounds<<<blocksFor(database.size), kThreads, 0, stream>>>(\n        database.data, database_count, database.dimension, grid_dimensions,\n        memory.bounds);\n    checkCuda(cudaPeekAtLastError(), \"launch computeBounds\");\n    finalizeGrid<<<1, 1, 0, stream>>>(\n        memory.bounds, grid_dimensions, grid_cell_capacity, radius,\n        memory.grid_parameters);\n    checkCuda(cudaPeekAtLastError(), \"launch finalizeGrid\");\n    recordProfileEvent(1, stream);\n\n    checkCuda(cudaMemsetAsync(memory.grid_counts, 0,\n                              grid_cell_capacity * sizeof(int), stream),\n              \"clear grid counts\");\n    insertPoints<<<blocksFor(database.size), kThreads, 0, stream>>>(\n        database.data, database_count, database.dimension,\n        memory.grid_parameters, memory.grid_counts, memory.point_cells,\n        memory.point_cell_indices);\n    checkCuda(cudaPeekAtLastError(), \"launch insertPoints\");\n    recordProfileEvent(2, stream);\n    checkCuda(cub::DeviceScan::ExclusiveSum(\n                  memory.scan_temporary, memory.scan_temporary_bytes,\n                  memory.grid_counts, memory.grid_offsets,\n                  grid_cell_capacity,\n                  stream),\n              \"prefix sum grid counts\");\n    recordProfileEvent(3, stream);\n    countingSort<<<blocksFor(database.size), kThreads, 0, stream>>>(\n        database.data, database_count, database.dimension, memory.point_cells,\n        memory.point_cell_indices, memory.grid_offsets,\n        memory.sorted_database, memory.sorted_database_indices);\n    checkCuda(cudaPeekAtLastError(), \"launch countingSort\");\n    recordProfileEvent(4, stream);\n\n    const float* search_query =\n        options.inputs_are_same ? memory.sorted_database : query.data;\n    const int* search_query_indices =\n        options.inputs_are_same ? memory.sorted_database_indices : nullptr;\n    launchGridNeighbors(\n        search_query, query_count, memory.sorted_database,\n        memory.sorted_database_indices, database_count, query.dimension,\n        memory.grid_parameters, memory.grid_offsets, radius, max_neighbors,\n        options.exclude_self, options.inputs_are_same,\n        search_query_indices, memory.neighbor_distances,\n        memory.neighbor_indices, stream);\n    checkCuda(cudaPeekAtLastError(), \"launch findNeighbors\");\n  }\n  recordProfileEvent(5, stream);\n  checkCuda(cudaMemsetAsync(memory.edge_counts, 0,\n                            (query.size + 1) * sizeof(std::int64_t), stream),\n            \"clear edge counts\");\n  countEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n      memory.neighbor_indices, query_count, max_neighbors, options.undirected,\n      memory.edge_counts);\n  checkCuda(cudaPeekAtLastError(), \"launch countEdges\");\n  recordProfileEvent(6, stream);\n  checkCuda(cub::DeviceScan::ExclusiveSum(\n                memory.scan_temporary, memory.scan_temporary_bytes,\n                memory.edge_counts, memory.edge_offsets, query_count + 1,\n                stream),\n            \"prefix sum edge counts\");\n  recordProfileEvent(7, stream);\n  if (!count_only) {\n    writeEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n        memory.neighbor_indices, query_count, max_neighbors,\n        options.undirected, memory.edge_offsets, output.edges);\n    checkCuda(cudaPeekAtLastError(), \"launch writeEdges\");\n  }\n  recordProfileEvent(8, stream);\n  checkCuda(cudaMemcpyAsync(\n                output.edge_count, memory.edge_offsets + query_count,\n                sizeof(std::int64_t), cudaMemcpyDeviceToDevice, stream),\n            \"copy edge count\");\n  recordProfileEvent(9, stream);\n}\n\n#if defined(FRNN_ENABLE_STAGE_PROFILING)\nnamespace detail {\n\nvoid profileBuildEdgesAsync(DevicePointView query, DevicePointView database,\n                            DeviceEdgeBuffer output, float radius,\n                            int max_neighbors, BuildOptions options,\n                            Workspace& workspace, cudaStream_t stream,\n                            float* stage_milliseconds, int stage_count) {\n  if (stage_milliseconds == nullptr ||\n      stage_count != kProfileEventCount - 1) {\n    throw std::invalid_argument(\"invalid stage profiling output\");\n  }\n  cudaEvent_t events[kProfileEventCount] = {};\n  for (cudaEvent_t& event : events) {\n    checkCuda(cudaEventCreate(&event), \"create profiling event\");\n  }\n  try {\n    active_profile_events = events;\n    buildEdgesAsync(query, database, output, radius, max_neighbors, options,\n                    workspace, stream);\n    active_profile_events = nullptr;\n    checkCuda(cudaEventSynchronize(events[kProfileEventCount - 1]),\n              \"synchronize profiling events\");\n    for (int stage = 0; stage < stage_count; ++stage) {\n      checkCuda(cudaEventElapsedTime(&stage_milliseconds[stage], events[stage],\n                                     events[stage + 1]),\n                \"calculate stage elapsed time\");\n    }\n  } catch (...) {\n    active_profile_events = nullptr;\n    for (cudaEvent_t event : events) {\n      if (event != nullptr) {\n        cudaEventDestroy(event);\n      }\n    }\n    throw;\n  }\n  for (cudaEvent_t event : events) {\n    cudaEventDestroy(event);\n  }\n}\n\n}  // namespace detail\n#endif\n\nstd::vector<Edge> buildEdges(PointView query, PointView database, float radius,\n                             int max_neighbors, BuildOptions options) {\n  validateHostValues(query, \"query\");\n  validateHostValues(database, \"database\");\n  if (query.dimension != database.dimension) {\n    throw std::invalid_argument(\n        \"query and database dimensions must be identical\");\n  }\n  validateConfiguration(radius, max_neighbors);\n  const std::int64_t capacity =\n      requiredEdgeCapacity(query.size, max_neighbors);\n  if (capacity == 0 || database.size == 0) {\n    return {};\n  }\n\n  float* device_query = nullptr;\n  float* device_database = nullptr;\n  std::int64_t* device_edges = nullptr;\n  std::int64_t* device_count = nullptr;\n  cudaStream_t stream = nullptr;\n  try {\n    checkCuda(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking),\n              \"create CUDA stream\");\n    allocateDevice(\n        &device_query,\n        static_cast<std::size_t>(query.size) * query.dimension,\n        \"allocate device query\");\n    const bool alias_inputs =\n        options.inputs_are_same && query.data == database.data &&\n        query.size == database.size;\n    if (alias_inputs) {\n      device_database = device_query;\n    } else {\n      allocateDevice(\n          &device_database,\n          static_cast<std::size_t>(database.size) * database.dimension,\n          \"allocate device database\");\n    }\n    allocateDevice(&device_count, 1, \"allocate device edge count\");\n\n    checkCuda(cudaMemcpyAsync(\n                  device_query, query.data,\n                  static_cast<std::size_t>(query.size) * query.dimension *\n                      sizeof(float),\n                  cudaMemcpyHostToDevice, stream),\n              \"copy query to device\");\n    if (!alias_inputs) {\n      checkCuda(cudaMemcpyAsync(\n                    device_database, database.data,\n                    static_cast<std::size_t>(database.size) *\n                        database.dimension * sizeof(float),\n                    cudaMemcpyHostToDevice, stream),\n                \"copy database to device\");\n    }\n\n    Workspace workspace;\n    workspace.reserve(query.size, database.size, query.dimension,\n                      max_neighbors, options.algorithm);\n    buildEdgesAsync(\n        {device_query, query.size, query.dimension},\n        {device_database, database.size, database.dimension},\n        {nullptr, 0, device_count}, radius, max_neighbors, options,\n        workspace, stream);\n\n    std::int64_t edge_count = 0;\n    checkCuda(cudaMemcpyAsync(&edge_count, device_count, sizeof(edge_count),\n                              cudaMemcpyDeviceToHost, stream),\n              \"copy edge count to host\");\n    checkCuda(cudaStreamSynchronize(stream), \"synchronize edge count\");\n    std::vector<Edge> result(static_cast<std::size_t>(edge_count));\n    if (edge_count > 0) {\n      allocateDevice(&device_edges,\n                     static_cast<std::size_t>(edge_count) * 2,\n                     \"allocate exact device edges\");\n      Workspace::Impl& memory = *workspace.impl_;\n      writeEdges<<<blocksFor(query.size), kThreads, 0, stream>>>(\n          memory.neighbor_indices, static_cast<int>(query.size),\n          max_neighbors, options.undirected, memory.edge_offsets,\n          device_edges);\n      checkCuda(cudaPeekAtLastError(), \"launch writeEdges\");\n      checkCuda(cudaMemcpyAsync(\n                    result.data(), device_edges,\n                    static_cast<std::size_t>(edge_count) * sizeof(Edge),\n                    cudaMemcpyDeviceToHost, stream),\n                \"copy edges to host\");\n      checkCuda(cudaStreamSynchronize(stream), \"synchronize edge output\");\n    }\n\n    freeDevice(device_count);\n    freeDevice(device_edges);\n    if (!alias_inputs) {\n      freeDevice(device_database);\n    }\n    freeDevice(device_query);\n    checkCuda(cudaStreamDestroy(stream), \"destroy CUDA stream\");\n    return result;\n  } catch (...) {\n    freeDevice(device_count);\n    freeDevice(device_edges);\n    if (device_database != device_query) {\n      freeDevice(device_database);\n    }\n    freeDevice(device_query);\n    if (stream != nullptr) {\n      cudaStreamDestroy(stream);\n    }\n    throw;\n  }\n}\n\nstd::vector<Edge> buildEdges(PointView points, float radius,\n                             int max_neighbors) {\n  BuildOptions options;\n  options.exclude_self = true;\n  options.undirected = true;\n  options.inputs_are_same = true;\n  return buildEdges(points, points, radius, max_neighbors, options);\n}\n\nvoid buildEdges(std::vector<float>& query, std::vector<float>& database,\n                std::vector<std::int64_t>& edge_list,\n                std::int64_t num_spacepoints, int embedding_dim, float r_max,\n                int k_max) {\n  if (num_spacepoints < 0 || embedding_dim <= 0) {\n    throw std::invalid_argument(\n        \"num_spacepoints and embedding_dim must be valid\");\n  }\n  const std::size_t expected =\n      static_cast<std::size_t>(num_spacepoints) * embedding_dim;\n  if (query.size() != expected || database.size() != expected) {\n    throw std::invalid_argument(\n        \"query and database vector sizes do not match the declared shape\");\n  }\n  BuildOptions options;\n  options.exclude_self = true;\n  options.undirected = true;\n  options.inputs_are_same = true;\n  const std::vector<Edge> edges =\n      buildEdges({query.data(), num_spacepoints, embedding_dim},\n                 {database.data(), num_spacepoints, embedding_dim}, r_max,\n                 k_max, options);\n  edge_list.reserve(edge_list.size() + edges.size() * 2);\n  for (const Edge& edge : edges) {\n    edge_list.push_back(edge.source);\n  }\n  for (const Edge& edge : edges) {\n    edge_list.push_back(edge.target);\n  }\n}\n\nvoid buildEdges(std::vector<float>& points,\n                std::vector<std::int64_t>& edge_list,\n                std::int64_t num_spacepoints, int embedding_dim, float r_max,\n                int k_max) {\n  if (num_spacepoints < 0 || embedding_dim <= 0 ||\n      points.size() !=\n          static_cast<std::size_t>(num_spacepoints) * embedding_dim) {\n    throw std::invalid_argument(\n        \"points vector size does not match the declared shape\");\n  }\n  const std::vector<Edge> edges =\n      buildEdges({points.data(), num_spacepoints, embedding_dim}, r_max, k_max);\n  edge_list.reserve(edge_list.size() + edges.size() * 2);\n  for (const Edge& edge : edges) {\n    edge_list.push_back(edge.source);\n  }\n  for (const Edge& edge : edges) {\n    edge_list.push_back(edge.target);\n  }\n}\n\n}  // namespace frnn\n","numLines":1281,"startLine":1,"totalLines":1281}}}
