{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015X5pJUj8rNrF1cJVDE4nTc","type":"tool_result","content":"755\t}\n756\t\n757\tint blocksForWarp(std::int64_t query_count, int warps_per_block) {\n758\t  if (query_count <= 0) return 1;\n759\t  const std::int64_t blocks =\n760\t      (query_count + warps_per_block - 1) / warps_per_block;\n761\t  return static_cast<int>(std::min<std::int64_t>(blocks, 65535));\n762\t}\n763\t\n764\tvoid launchGridNeighborsWarpCoop(\n765\t    const float* query, int query_count, const float* sorted_database,\n766\t    const int* sorted_database_indices, int database_count, int dimension,\n767\t    const GridParameters* parameters, const int* grid_offsets, float radius,\n768\t    int max_neighbors, bool exclude_self, bool inputs_are_same,\n769\t    const int* query_indices, float* neighbor_distances,\n770\t    int* neighbor_indices, cudaStream_t stream) {\n771\t  constexpr int kWarpsPerBlock = 8;\n772\t  constexpr int kThreadsWarp = kWarpsPerBlock * 32;\n773\t  const int blocks = blocksForWarp(query_count, kWarpsPerBlock);\n774\t#define FRNN_LAUNCH_GRID_WARP(Dimension)                                   \\\n775\t  findNeighborsWarpCoop<Dimension>                                         \\\n776\t      <<<blocks, kThreadsWarp, 0, stream>>>(                               \\\n777\t          query, query_count, sorted_database, sorted_database_indices,    \\\n778\t          database_count, dimension, parameters, grid_offsets, radius,     \\\n779\t          max_neighbors, exclude_self, inputs_are_same, query_indices,     \\\n780\t          neighbor_distances, neighbor_indices)\n781\t  switch (dimension) {\n782\t    case 1:\n783\t      FRNN_LAUNCH_GRID_WARP(1);\n784\t      break;\n785\t    case 2:\n786\t      FRNN_LAUNCH_GRID_WARP(2);\n787\t      break;\n788\t    case 3:\n789\t      FRNN_LAUNCH_GRID_WARP(3);\n790\t      break;\n791\t    case 4:\n792\t      FRNN_LAUNCH_GRID_WARP(4);\n793\t      break;\n794\t    case 8:\n795\t      FRNN_LAUNCH_GRID_WARP(8);\n796\t      break;\n797\t    case 12:\n798\t      FRNN_LAUNCH_GRID_WARP(12);\n799\t      break;\n800\t    case 16:\n801\t      FRNN_LAUNCH_GRID_WARP(16);\n802\t      break;\n803\t    default:\n804\t      FRNN_LAUNCH_GRID_WARP(0);\n805\t      break;\n806\t  }\n807\t#undef FRNN_LAUNCH_GRID_WARP\n808\t}\n809\t\n810\t__global__ void countEdges(const int* neighbor_indices,\n811\t                           int query_count, int max_neighbors,\n812\t                           bool undirected, std::int64_t* edge_counts) {\n813\t  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n814\t       query_index < query_count;\n815\t       query_index += blockDim.x * gridDim.x) {\n816\t    std::int64_t count = 0;\n817\t    const int* neighbors =\n818\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n819\t                               max_neighbors;\n820\t    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n821\t      const int target = neighbors[neighbor];\n822\t      if (target < 0) {\n823\t        break;\n824\t      }\n825\t      if (!undirected || query_index > target) {\n826\t        ++count;\n827\t      }\n828\t    }\n829\t    edge_counts[query_index] = count;\n830\t  }\n831\t}\n832\t\n833\t__global__ void writeEdges(const int* neighbor_indices,\n834\t                           int query_count, int max_neighbors,\n835\t                           bool undirected,\n836\t                           const std::int64_t* edge_offsets,\n837\t                           std::int64_t* edges) {\n838\t  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n839\t       query_index < query_count;\n840\t       query_index += blockDim.x * gridDim.x) {\n841\t    std::int64_t output_index = edge_offsets[query_index];\n842\t    const int* neighbors =\n843\t        neighbor_indices + static_cast<std::int64_t>(query_index) *\n844\t                               max_neighbors;\n845\t    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n846\t      const int target = neighbors[neighbor];\n847\t      if (target < 0) {\n848\t        break;\n849\t      }\n850\t      if (!undirected || query_index > target) {\n851\t        edges[output_index * 2] = query_index;\n852\t        edges[output_index * 2 + 1] = target;\n853\t        ++output_index;\n854\t      }"}]},"parent_tool_use_id":null,"session_id":"6f82439e-67c9-4df8-8006-0f75deb44a8f","uuid":"51159b61-d000-442a-a3e2-18fb15256b27","timestamp":"2026-09-20T23:37:17.181Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/libFRNN/src/frnn.cu","content":"}\n\nint blocksForWarp(std::int64_t query_count, int warps_per_block) {\n  if (query_count <= 0) return 1;\n  const std::int64_t blocks =\n      (query_count + warps_per_block - 1) / warps_per_block;\n  return static_cast<int>(std::min<std::int64_t>(blocks, 65535));\n}\n\nvoid launchGridNeighborsWarpCoop(\n    const float* query, int query_count, const float* sorted_database,\n    const int* sorted_database_indices, int database_count, int dimension,\n    const GridParameters* parameters, const int* grid_offsets, float radius,\n    int max_neighbors, bool exclude_self, bool inputs_are_same,\n    const int* query_indices, float* neighbor_distances,\n    int* neighbor_indices, cudaStream_t stream) {\n  constexpr int kWarpsPerBlock = 8;\n  constexpr int kThreadsWarp = kWarpsPerBlock * 32;\n  const int blocks = blocksForWarp(query_count, kWarpsPerBlock);\n#define FRNN_LAUNCH_GRID_WARP(Dimension)                                   \\\n  findNeighborsWarpCoop<Dimension>                                         \\\n      <<<blocks, kThreadsWarp, 0, stream>>>(                               \\\n          query, query_count, sorted_database, sorted_database_indices,    \\\n          database_count, dimension, parameters, grid_offsets, radius,     \\\n          max_neighbors, exclude_self, inputs_are_same, query_indices,     \\\n          neighbor_distances, neighbor_indices)\n  switch (dimension) {\n    case 1:\n      FRNN_LAUNCH_GRID_WARP(1);\n      break;\n    case 2:\n      FRNN_LAUNCH_GRID_WARP(2);\n      break;\n    case 3:\n      FRNN_LAUNCH_GRID_WARP(3);\n      break;\n    case 4:\n      FRNN_LAUNCH_GRID_WARP(4);\n      break;\n    case 8:\n      FRNN_LAUNCH_GRID_WARP(8);\n      break;\n    case 12:\n      FRNN_LAUNCH_GRID_WARP(12);\n      break;\n    case 16:\n      FRNN_LAUNCH_GRID_WARP(16);\n      break;\n    default:\n      FRNN_LAUNCH_GRID_WARP(0);\n      break;\n  }\n#undef FRNN_LAUNCH_GRID_WARP\n}\n\n__global__ void countEdges(const int* neighbor_indices,\n                           int query_count, int max_neighbors,\n                           bool undirected, std::int64_t* edge_counts) {\n  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n       query_index < query_count;\n       query_index += blockDim.x * gridDim.x) {\n    std::int64_t count = 0;\n    const int* neighbors =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n      const int target = neighbors[neighbor];\n      if (target < 0) {\n        break;\n      }\n      if (!undirected || query_index > target) {\n        ++count;\n      }\n    }\n    edge_counts[query_index] = count;\n  }\n}\n\n__global__ void writeEdges(const int* neighbor_indices,\n                           int query_count, int max_neighbors,\n                           bool undirected,\n                           const std::int64_t* edge_offsets,\n                           std::int64_t* edges) {\n  for (int query_index = blockIdx.x * blockDim.x + threadIdx.x;\n       query_index < query_count;\n       query_index += blockDim.x * gridDim.x) {\n    std::int64_t output_index = edge_offsets[query_index];\n    const int* neighbors =\n        neighbor_indices + static_cast<std::int64_t>(query_index) *\n                               max_neighbors;\n    for (int neighbor = 0; neighbor < max_neighbors; ++neighbor) {\n      const int target = neighbors[neighbor];\n      if (target < 0) {\n        break;\n      }\n      if (!undirected || query_index > target) {\n        edges[output_index * 2] = query_index;\n        edges[output_index * 2 + 1] = target;\n        ++output_index;\n      }","numLines":100,"startLine":755,"totalLines":1452}}}
